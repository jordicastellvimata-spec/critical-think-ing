---
import Base from '../layouts/Base.astro';
import JournalCover from '../components/JournalCover.astro';
import FeaturedBooks from '../components/FeaturedBooks.astro';
import TeachingVideoGallery from '../components/TeachingVideoGallery.astro';
import PracticeMaterials from '../components/PracticeMaterials.astro';
import ThesisSpotlight from '../components/ThesisSpotlight.astro';
import EditorialActivities from '../components/EditorialActivities.astro';
import ScientificConferences from '../components/ScientificConferences.astro';
import TeacherResources from '../components/TeacherResources.astro';
import DiscoProject from '../components/DiscoProject.astro';
import FinancialEducationCourse from '../components/FinancialEducationCourse.astro';
import QuestionarActivities from '../components/QuestionarActivities.astro';
import RelatInvisible from '../components/RelatInvisible.astro';
import MiradesEnDisputa from '../components/MiradesEnDisputa.astro';
import CriticalReadingCards from '../components/CriticalReadingCards.astro';
import ThinkingCloud from '../components/ThinkingCloud.astro';
import Brain3DIcon from '../components/Brain3DIcon.astro';
import HeroSocialLinks from '../components/HeroSocialLinks.astro';
import { criticalLiteracyDimensions, criticalLiteracyCitation } from '../data/criticalLiteracyDimensions';
import {profile, themes, publications, researchProjects, otherInitiatives, jornades2027} from '../data/site';
const root=import.meta.env.BASE_URL.replace(/\/$/,'');
const to=(s='')=>root+'/'+s.replace(/^\//,'');
---
<Base title="Jordi Castellví Mata" seoTitle="Jordi Castellví Mata | Pensament crític i ciències socials" active="home" description="Web acadèmica de Jordi Castellví Mata, investigador a la UAB. Didàctica de les ciències socials, pensament crític, educació democràtica i publicacions.">
  <div class="hero-scroll-scene">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy scroll-cinematic-hero">
        <div class="eyebrow hero-eyebrow"><span class="hero-eyebrow-content"><span class="hero-eyebrow-name">Jordi Castellví Mata</span><span class="hero-eyebrow-separator"> · </span><span class="hero-eyebrow-university">Universitat Autònoma de Barcelona</span></span></div>
        <h1 class="display">Llegir el món.<br /><span>Escriure el futur.</span></h1>
        <p class="lead">Investigo com l'educació pot ajudar-nos a qüestionar allò que donem per fet, comprendre críticament el present i imaginar futurs més justos.</p>
        <HeroSocialLinks />
        <div class="hero-actions">
          <a class="btn" href="#publicacions">Explorar publicacions <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="#sobre-mi">Conèixer la meva trajectòria <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
    <div class="container hero-foot"><span>RECERCA · DOCÈNCIA · TRANSFERÈNCIA</span><span>CRITICAL THINKING / SOCIAL SCIENCES EDUCATION</span><a href="#recerca">DESCOBREIX MÉS ↓</a></div>
  </section>
  </div>





<section class="section topics-section" id="recerca">
    <div class="container">
      <div class="section-head">
        <div><div class="eyebrow">Àmbit de recerca · Didàctica de les ciències socials</div><h2 class="section-title">Idees que es converteixen en <span class="section-cyan">recerca.</span></h2><h3 class="subsection-title topic-subtitle">Línies de recerca</h3></div>
        <p>Investigo com interpretem el món social i com l’educació pot ajudar a qüestionar discursos i formar una ciutadania crítica.</p>
      </div>
      <div class="topics-grid">
        {themes.map(t=><article class="topic-card"><div class="topic-top"><span>{t.number} / 04</span><span class="topic-asterisk"><Brain3DIcon monochrome /></span></div><h4>{t.name}</h4><p>{t.detail}</p><small>{t.english}</small></article>)}
      </div>
    </div>
  </section>

<section class="section projects-section" id="projectes">
    <div class="container">
      <div class="section-head">
        <div><div class="eyebrow">Projectes i activitat científica</div><h3 class="subsection-title">Projectes de recerca</h3></div>
        <p>Educació democràtica, ciutadania i pensament crític: projectes col·lectius que busquen comprendre la realitat i transformar l'educació.</p>
      </div>
      <div class="project-grid">
        <article class="project-feature">
          <div class="project-meta"><span>PROJECTE DE RECERCA · EN CURS</span><span>{researchProjects[0].period}</span></div>
          <div class="project-content"><span class="project-code">{researchProjects[0].code}</span><h4>{researchProjects[0].title}</h4><p>{researchProjects[0].description}</p><a href="#mes-projectes" class="project-link">Altres projectes de recerca <span aria-hidden="true">↗</span></a></div>
          <div class="project-funding" aria-label="Entitats finançadores del projecte PID2024-160676OB-I00">
            <div class="project-funding-logos">
              <span class="project-funding-fallback" aria-hidden="true">MICIU <span>·</span> UE <span>·</span> AEI</span>
              <img src="https://raw.githubusercontent.com/project-auroras/auroras/main/logos/MICIU%2BCofinanciado%2BAEI.jpg" alt="Logotips del Ministeri de Ciència, Innovació i Universitats, de la Unió Europea i de l’Agència Estatal d’Investigació" loading="lazy" decoding="async" onerror="this.style.display='none'" />
            </div>
            <div class="project-funding-info">
              <span class="project-funding-kicker">FINANÇAMENT INSTITUCIONAL</span>
              <span class="project-funding-credit">MICIU/AEI/10.13039/501100011033 · FEDER, UE</span>
            </div>
          </div>
          <div class="project-circle" aria-hidden="true"></div>
        </article>
        
      </div>
      <div class="research-mini-list" id="mes-projectes" aria-label="Altres projectes de recerca">
        {researchProjects.slice(1,3).map(p=><article class="research-mini"><div><span class="mini">{p.period} · {p.code}</span><h4>{p.title}</h4><p>{p.description}</p></div><span class="research-role">{p.role}</span></article>)}
      </div>

      <DiscoProject />
      <p class="section-deeper-wrap"><a class="section-deeper-link" href={to("projectes/")}>Veure tots els projectes ↗</a></p>
      <a class="research-to-practice" href="#transferencia">...que connecta amb la pràctica <span aria-hidden="true">↓</span></a>
    </div>
  </section>

<section class="section research-networks" id="xarxes-academiques">
    <div class="container">
      <div class="section-head"><div><div class="eyebrow">Grups i xarxes de recerca</div><h3 class="subsection-title">Equips i xarxes de recerca</h3></div></div>
      <div class="network-grid research-network-grid">
        <article class="network-feature gredics-feature">
          <div class="network-topline">GRUP DE RECERCA · UAB</div>
          <div class="gredics-identity">
            <img class="gredics-official-logo" src={to('images/gredics-logo.svg')} alt="Logotip de GREDICS, Grup de Recerca en Didàctica de les Ciències Socials" width="654" height="180" loading="lazy" decoding="async" />
          </div>
          <h4>Grup de Recerca en Didàctica de les Ciències Socials</h4>
          <p>Recerca sobre educació per a la ciutadania, pensament crític, història, problemes socials i cultura democràtica a la Universitat Autònoma de Barcelona.</p>
          <div class="network-actions">
            <a href={profile.gredics} target="_blank" rel="noopener noreferrer">Web de GREDICS ↗</a>
            <a href={profile.gredicsProfile} target="_blank" rel="noopener noreferrer">El meu perfil ↗</a>
          </div>
        </article>
        <article class="network-feature red14-feature">
          <div class="network-topline">XARXA DE RECERCA · DIDÀCTICA DE LES CIÈNCIES SOCIALS</div>
          <div class="red14-logo-holder">
            <span class="red14-logo-fallback" aria-hidden="true">Red<span>14</span></span>
            <img src="https://red14.net/wp-content/uploads/2023/10/red14logo.png" alt="Logotip de Red14, xarxa d'investigació en ensenyament de les ciències socials" width="320" height="110" loading="lazy" decoding="async" onerror="this.style.display='none';this.previousElementSibling.style.display='block'" />
          </div>
          <h4>Red14 · Xarxa d'investigació en ensenyament de les ciències socials</h4>
          <p>Formo part de Red14 a través de GREDICS, un dels grups integrants de la xarxa. Constituïda el 2014, reuneix equips de recerca de diverses universitats de l’Estat espanyol per impulsar la col·laboració científica, la formació d’investigadors i la transferència del coneixement al professorat.</p>
          <div class="network-actions">
            <a href="https://red14.net/" target="_blank" rel="noopener noreferrer">Web de Red14 ↗</a>
            <a href="https://red14.net/grupos/" target="_blank" rel="noopener noreferrer">Grups de la xarxa ↗</a>
          </div>
        </article>
        
      </div>
    </div>
  </section>

<section class="section section-alt" id="publicacions">
    <div class="container">
      <div class="section-head">
        <div><div class="eyebrow">Producció científica · Publicacions acadèmiques</div><h2 class="section-title">Recerca que connecta amb la <span class="section-cyan">pràctica.</span></h2></div>
      </div>
      <FeaturedBooks />
      <h3 class="articles-section-title">Articles de recerca</h3>
      <div class="paper-list">
        {publications.slice(0,5).map(p=><a class="paper paper-visual" href={p.url} target="_blank" rel="noopener noreferrer" aria-label={p.title + '. Obrir la publicació'}><span class="year">{p.year}</span><JournalCover venue={p.venue}/><div class="paper-copy"><div class="tag">{p.venue} <span class="pub-type">· {p.indexing.join(' · ')}</span></div><h4>{p.title}</h4><p>{p.authors}</p></div><span class="arrow" aria-hidden="true">↗</span></a>)}
      </div>
      <details class="publication-disclosure">
        <summary class="publication-disclosure-trigger">
          <span class="publication-label-more">Mostra tots els articles</span>
          <span class="publication-label-less">Mostra menys articles</span>
          <span class="publication-disclosure-count">({publications.length})</span>
          <span class="publication-disclosure-icon" aria-hidden="true">+</span>
        </summary>
        <div class="paper-list publication-extra-list">
          {publications.slice(5).map(p=><a class="paper paper-visual" href={p.url} target="_blank" rel="noopener noreferrer" aria-label={p.title + '. Obrir la publicació'}><span class="year">{p.year}</span><JournalCover venue={p.venue}/><div class="paper-copy"><div class="tag">{p.venue} <span class="pub-type">· {p.indexing.join(' · ')}</span></div><h4>{p.title}</h4><p>{p.authors}</p></div><span class="arrow" aria-hidden="true">↗</span></a>)}
        </div>
      </details>
      <p class="list-foot"><a href={profile.uab} target="_blank" rel="noopener noreferrer">Portal de Recerca de la UAB ↗</a></p>
      <EditorialActivities />
      <ScientificConferences />
    </div>
  </section>

<section class="section practice-section practice-standalone" id="transferencia">
    <div class="container">
        <div class="section-head">
          <div><div class="eyebrow">Transferència i formació</div><h2 class="section-title">Transferència a la formació de mestres.</h2></div>
          <p>La formació del professorat i el debat entre l'escola i la universitat són parts essencials de la recerca educativa.</p>
        </div>
        <h3 class="subsection-title">Formació inicial</h3>
        <TeachingVideoGallery embedded={true} />
        <h3 class="subsection-title subsection-offset">Formació permanent</h3>
        <div class="continuing-courses-grid">
          <a class="practice-card practice-mooc" href={otherInitiatives[1].url} target="_blank" rel="noopener noreferrer">
            <span class="mini">FORMACIÓ OBERTA · COURSERA</span>
            <div class="practice-brand" aria-label="Coursera"><img src="/images/coursera-symbol.svg" alt="" width="43" height="43" loading="lazy" decoding="async" /><span class="practice-brand-wordmark" aria-hidden="true">coursera</span></div>
            <div class="practice-card-copy">
              <h4>La formación del pensamiento crítico en la era digital</h4>
              <p>MOOC de la UAB sobre literacitat crítica, ciutadania i educació democràtica, del qual soc codirector i docent.</p>
              <strong>Explorar el curs ↗</strong>
            </div>
          </a>
          <FinancialEducationCourse nested={true} compact={true} />
        </div>
        <TeacherResources />

    </div>
  </section>

<section class="section classroom-section" id="aules">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Materials curriculars i projectes educatius</div>
          <h2 class="section-title">Transferència a les <span class="section-cyan">aules.</span></h2>
        </div>
      </div>
      <PracticeMaterials />
    </div>
  </section>

<section class="section misc-experiences-section" aria-labelledby="more-experiences-heading">
  <div class="container">
        <div class="training-experiences">
          <h2 class="subsection-title" id="more-experiences-heading">Altres experiències de formació i col·laboració</h2>
          <div class="training-experiences-grid">
            {[
              {institution:'Universitat Rovira i Virgili',year:'2024',title:'Literacitat crítica: formar el pensament crític a l’escola qüestionant allò comú',icon:'M4 19.5V4.5a2 2 0 0 1 2-2h12v17H6a2 2 0 0 0-2 2m0-17a2 2 0 0 1 2-2h12v17H6a2 2 0 0 0-2 2z'},
              {institution:'Universitat de Màlaga',year:'2021–2023',title:'Literacidad Crítica. Formar el pensamiento crítico en Educación Infantil',icon:'M12 3 2 8l10 5 10-5-10-5Zm-7 7v5c4 3 10 3 14 0v-5M22 8v6'},
              {institution:'Universitat de Jaén',year:'2024',title:'Critical digital literacy: ideology, disinformation and multiperspective',detail:'Conferència al programa «New Technologies and Human Rights»',icon:'M3 3h18v14H3zM8 21h8M12 17v4M7 12l3-3 2 2 4-4'},
              {institution:'Serveis Territorials del Vallès Occidental',year:'2025–2026',title:'Formar el Pensament Crític en la Societat Digital',icon:'M4 4h16v12H4zM2 20h20M8 10l3 3 5-6'},
              {institution:'Servei Educatiu Sants-Montjuïc',year:'2025',title:'Interculturalitat, discursos d’odi i DCCSS',icon:'M21 11.5a8.5 8.5 0 0 1-8.5 8.5 9 9 0 0 1-4-.9L3 21l1.9-5.5a8.5 8.5 0 1 1 16.1-4zM8 10h8M8 14h5'},
              {institution:'Rosa Sensat',year:'2022',title:'Treball globalitzat en torn als problemes socials rellevants i a la humanització dels sabers',detail:'Formació presencial impartida a la 57a Escola d’Estiu',icon:'M4 5h7v14H4zM13 5h7v14h-7zM7 9h1M16 9h1M7 13h1M16 13h1'},
              {institution:'Rosa Sensat',year:'2022',title:'Problemes socials rellevants i humanització dels sabers',detail:'Formació en línia impartida a l’Escola d’Estiu',icon:'M3 5h18v12H3zM8 21h8M12 17v4M7 9h10M7 13h7'},
              {institution:'AUPDCS',year:'2025',title:'Inteligencia artificial ¿aliada? en la investigación en Didáctica de las Ciencias Sociales. Algunos ejemplos prácticos',detail:'Webinar sobre intel·ligència artificial aplicada a la recerca',icon:'M12 3v3M6 6l2 2M3 12h3M6 18l2-2M12 21v-3M18 18l-2-2M21 12h-3M18 6l-2 2M9 9h6v6H9z'}
            ].map(item=><article class="training-experience">
              <span class="training-experience-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round"><path d={item.icon} /></svg></span>
              <div class="training-experience-body"><div class="training-experience-meta"><span>{item.institution}</span>{item.year && <span>{item.year}</span>}</div><h4>{item.title}</h4>{item.detail && <p class="training-experience-detail">{item.detail}</p>}</div>
            </article>)}
          </div>
          <details class="training-podcast" id="rosa-sensat-podcast">
            <summary class="training-podcast-summary">
              <span class="training-podcast-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3v18l15-9L5 3z" /></svg></span>
              <span class="training-podcast-copy">
                <span class="training-podcast-meta">PÒDCAST · ROSA SENSAT · 2022</span>
                <span class="training-podcast-title">L’aula com a projecte, les metodologies globalitzades</span>
                <span class="training-podcast-people">Episodi 3 · Fernando Hernández, Xavi Geis, Mariona Massip i Jordi Castellví</span>
              </span>
              <span class="training-podcast-cta">Escolta l’episodi <span aria-hidden="true">⌄</span></span>
            </summary>
            <div class="training-podcast-player">
              <iframe
                src="https://open.spotify.com/embed/episode/3HizQi754Rkb6mJhu1ZZT1"
                title="Reproductor de l’episodi 3 del pòdcast de Rosa Sensat"
                width="100%"
                height="152"
                loading="lazy"
                style="border:0;border-radius:9px"
                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
              ></iframe>
              <div class="training-podcast-links">
                <a href="https://www.rosasensat.org/ca/el-podcast-de-la-57a-escola-destiu-laula-com-a-projecte-metodologies-globalitzades" target="_blank" rel="noopener noreferrer">Fitxa de l’episodi a Rosa Sensat ↗</a>
                <a href="https://open.spotify.com/episode/3HizQi754Rkb6mJhu1ZZT1" target="_blank" rel="noopener noreferrer">Obrir a Spotify ↗</a>
              </div>
            </div>
          </details>
        </div>
        <style>
          .training-experiences{margin-top:0;padding-top:1.35rem;border-top:1px solid var(--border,rgba(110,130,145,.24))}
          .training-experiences>.subsection-title{margin-bottom:1.1rem}
          .training-experiences-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;align-items:stretch}
          .training-experience{display:flex;flex-direction:column;gap:9px;padding:14px 12px;min-width:0;border:1px solid rgba(105,133,145,.2);border-radius:10px;background:var(--surface,#fff)}
          .training-experience-icon{display:flex;width:32px;height:32px;align-items:center;justify-content:center;border-radius:9px;background:rgba(22,171,192,.09);color:#098da8;flex-shrink:0}
          .training-experience-icon svg{width:20px;height:20px}
          .training-experience-body{display:flex;flex-direction:column;gap:5px;min-width:0}
          .training-experience-meta{display:flex;gap:3px 8px;align-items:baseline;justify-content:space-between;flex-wrap:wrap;font-size:.66rem;line-height:1.35;color:var(--muted,#5e7078)}
          .training-experience-meta span:first-child{font-weight:650}
          .training-experience-meta span:last-child{white-space:nowrap}
          .training-experience h4{font-size:clamp(.79rem,.91vw,.89rem);line-height:1.35;font-weight:550;margin:0;color:var(--ink,#17252c);overflow-wrap:break-word;hyphens:auto}
          .training-experience-detail{font-size:.72rem;line-height:1.4;color:var(--muted,#5e7078);margin:0;overflow-wrap:break-word}
          .training-podcast{margin-top:14px;border:1px solid rgba(105,133,145,.24);border-radius:10px;background:var(--white);overflow:hidden}
          .training-podcast-summary{display:flex;align-items:center;gap:13px;padding:12px 15px;cursor:pointer;list-style:none}
          .training-podcast-summary::-webkit-details-marker{display:none}
          .training-podcast-summary:focus-visible{outline:2px solid var(--cyan);outline-offset:-3px}
          .training-podcast-icon{width:32px;height:32px;flex:0 0 32px;display:grid;place-items:center;border-radius:50%;background:var(--cyan-pale);color:var(--cyan)}
          .training-podcast-copy{display:flex;flex:1;min-width:0;flex-direction:column;gap:2px}
          .training-podcast-meta{font:750 9px/1.4 'DM Sans',sans-serif;letter-spacing:.07em;color:var(--red)}
          .training-podcast-title{font:650 13px/1.35 'Manrope',sans-serif;color:var(--ink)}
          .training-podcast-people{font:400 11px/1.45 'DM Sans',sans-serif;color:var(--muted)}
          .training-podcast-cta{font:750 11px/1.35 'DM Sans',sans-serif;white-space:nowrap;color:var(--cyan)}
          .training-podcast-cta span{display:inline-block;font-size:17px;vertical-align:middle;transition:transform .2s}
          .training-podcast[open] .training-podcast-cta span{transform:rotate(180deg)}
          .training-podcast-player{border-top:1px solid var(--line);padding:13px 15px 15px;display:grid;gap:10px}
          .training-podcast-player iframe{display:block;max-width:720px}
          .training-podcast-links{display:flex;flex-wrap:wrap;gap:7px 20px}
          .training-podcast-links a{font:700 11px/1.5 'DM Sans',sans-serif;text-decoration:none;color:var(--cyan)}
          .training-podcast-links a:hover{color:var(--red)}
          @media(max-width:500px){.training-podcast-summary{flex-wrap:wrap;gap:8px 10px;padding:12px}.training-podcast-copy{flex-basis:calc(100% - 44px)}.training-podcast-cta{margin-left:42px}.training-podcast-player{padding:12px}}
          @media(max-width:1080px){.training-experiences-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
          @media(max-width:760px){.training-experiences-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
          @media(max-width:500px){.training-experiences-grid{grid-template-columns:1fr;gap:9px}.training-experience{flex-direction:row;padding:13px;gap:11px}.training-experience-icon{width:32px;height:32px}.training-experiences{margin-top:0}}
          .section.misc-experiences-section{padding:18px 0 52px;background:var(--white)}
          @media(max-width:760px){.section.misc-experiences-section{padding:10px 0 44px}}
        </style>
  </div>
</section>

<section class="lab-banner" id="laboratori">
    <div class="container lab-grid">
      <div><div class="eyebrow">Conceptes · Preguntes · Activitats</div><h2>Laboratori de<br/><em>Pensament Crític.</em></h2><p>Qüestionar allò que donem per fet, escoltar mirades diverses, comprendre les desigualtats i actuar per transformar la realitat.</p><a class="btn" href="#activitats-laboratori">Explorar les quatre dimensions <span aria-hidden="true">↗</span></a></div>
      <div class="lab-art lab-word-cloud"><ThinkingCloud /></div>
    </div>
    <div class="container lab-prompts" id="activitats-laboratori" aria-label="Quatre dimensions de la literacitat crítica">
      {criticalLiteracyDimensions.map(d => d.number === '01' ? (
        <details class="lab-disclosure" id="questionar-allo-comu">
          <summary class="lab-prompt">
            <span class="lab-prompt-title">{d.title}</span>
            <span class="lab-prompt-description">{d.description}</span>
            <span class="lab-prompt-action"><span>Comença l’experiment</span><span class="lab-chevron" aria-hidden="true"></span></span>
          </summary>
          <RelatInvisible />
          <section class="ri-practice" id="per-exercitar-pensament-critic" aria-labelledby="ri-practice-title">
            <div class="ri-practice-kicker">Explora les set activitats</div>
            <h3 id="ri-practice-title">Per exercitar el pensament crític</h3>
            <p>Set propostes per qüestionar allò que donem per fet i traslladar aquesta mirada a la formació del professorat i a l’aula.</p>
            <QuestionarActivities />
          </section>
        </details>
      ) : d.number === '02' ? (
