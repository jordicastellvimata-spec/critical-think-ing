---
import Base from '../layouts/Base.astro';
import JournalCover from '../components/JournalCover.astro';
import FeaturedBooks from '../components/FeaturedBooks.astro';
import TeachingVideoGallery from '../components/TeachingVideoGallery.astro';
import PracticeMaterials from '../components/PracticeMaterials.astro';
import TeacherResources from '../components/TeacherResources.astro';
import DiscoProject from '../components/DiscoProject.astro';
import CriticalReadingCards from '../components/CriticalReadingCards.astro';
import ThesisSpotlight from '../components/ThesisSpotlight.astro';
import AsteriskIcon from '../components/AsteriskIcon.astro';
import HeroSocialLinks from '../components/HeroSocialLinks.astro';
import { criticalLiteracyDimensions, criticalLiteracyCitation } from '../data/criticalLiteracyDimensions';
import {profile, themes, publications, researchProjects, otherInitiatives, jornades2027} from '../data/site';
const root=import.meta.env.BASE_URL.replace(/\/$/,'');
const to=(s='')=>root+'/'+s.replace(/^\//,'');
---
<Base title="Jordi Castellví Mata" active="home" description="Espai acadèmic de Jordi Castellví Mata: pensament crític, educació democràtica, publicacions, projectes i divulgació.">
  <div class="hero-scroll-scene">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy scroll-cinematic-hero">
        <div class="eyebrow">Jordi Castellví Mata · Universitat Autònoma de Barcelona</div>
        <h1 class="display">Llegir el món.<br /><span>Escriure el futur.</span></h1>
        <p class="lead">Investigo com l'educació pot ajudar-nos a qüestionar allò que donem per fet, comprendre críticament el present i imaginar futurs més justos.</p>
        <HeroSocialLinks />
        <div class="hero-actions">
          <a class="btn" href="#publicacions">Explorar publicacions <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="#sobre-mi">Conèixer la meva trajectòria <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
    <div class="container hero-foot"><span>RECERCA · DOCÈNCIA · TRANSFERÈNCIA</span><span>CRITICAL THINKING / SOCIAL SCIENCES EDUCATION</span><a href="#recerca">DESCOBREIX MÉS ↓</a></div>
  </section>
  </div>

  <section class="section topics-section" id="recerca">
    <div class="container">
      <div class="section-head">
        <div><div class="eyebrow">Àmbit de recerca · Didàctica de les ciències socials</div><h2 class="section-title">Línies<br/>de recerca.</h2></div>
        <p>Investigo com interpretem el món social i com l’educació pot ajudar a qüestionar discursos i formar una ciutadania crítica.</p>
      </div>
      <div class="topics-grid">
        {themes.map(t=><article class="topic-card"><div class="topic-top"><span>{t.number} / 04</span><span class="topic-asterisk"><AsteriskIcon /></span></div><h3>{t.name}</h3><p>{t.detail}</p><small>{t.english}</small></article>)}
      </div>
    </div>
  </section>

  <section class="section section-alt" id="publicacions">
    <div class="container">
      <div class="section-head">
        <div><div class="eyebrow">Producció científica · Publicacions acadèmiques</div><h2 class="section-title">Idees que es<br/>converteixen en recerca.</h2></div>
      </div>
      <FeaturedBooks />
      <h3 class="articles-section-title">Articles de recerca</h3>
      <div class="paper-list">
        {publications.map(p=><a class="paper paper-visual" href={p.url} target="_blank" rel="noopener noreferrer" aria-label={p.title + '. Obrir la publicació'}><span class="year">{p.year}</span><JournalCover venue={p.venue}/><div class="paper-copy"><div class="tag">{p.venue} <span class="pub-type">· {p.indexing.join(' · ')}</span></div><h3>{p.title}</h3><p>{p.authors}</p></div><span class="arrow" aria-hidden="true">↗</span></a>)}
      </div>
      <p class="list-foot"><a href={profile.uab} target="_blank" rel="noopener noreferrer">Portal de Recerca de la UAB ↗</a></p>
    </div>
  </section>

  <section class="section projects-section" id="projectes">
    <div class="container">
      <div class="section-head">
        <div><div class="eyebrow">Projectes i activitat científica</div><h2 class="section-title">Recerca...</h2></div>
        <p>Educació democràtica, ciutadania i pensament crític: projectes col·lectius que busquen comprendre la realitat i transformar l'educació.</p>
      </div>
      <div class="project-grid">
        <article class="project-feature">
          <div class="project-meta"><span>PROJECTE DE RECERCA · EN CURS</span><span>{researchProjects[0].period}</span></div>
          <div class="project-content"><span class="project-code">{researchProjects[0].code}</span><h3>{researchProjects[0].title}</h3><p>{researchProjects[0].description}</p><a href="#mes-projectes" class="project-link">Altres projectes de recerca <span aria-hidden="true">↗</span></a></div>
          <div class="project-funding" aria-label="Entitats finançadores del projecte PID2024-160676OB-I00">
            <span class="project-funding-kicker">PROJECTE PID2024-160676OB-I00 · FINANÇAMENT</span>
            <div class="project-funding-logos">
              <span class="project-funding-fallback" aria-hidden="true">MICIU <span>·</span> COFINANCIADO POR LA UNIÓN EUROPEA <span>·</span> AEI</span>
              <img src="https://raw.githubusercontent.com/project-auroras/auroras/main/logos/MICIU%2BCofinanciado%2BAEI.jpg" alt="Logotips de les entitats finançadores: Ministerio de Ciencia, Innovación y Universidades; Cofinanciado por la Unión Europea; Agencia Estatal de Investigación" loading="lazy" decoding="async" onerror="this.style.display='none'" />
            </div>
            <span class="project-funding-credit">Finançat per MICIU/AEI/10.13039/501100011033 i per FEDER, UE.</span>
          </div>
          <div class="project-circle" aria-hidden="true"></div>
        </article>
        <a class="initiative editorial-research" href={otherInitiatives[0].url} target="_blank" rel="noopener noreferrer">
          <span>EDICIÓ CIENTÍFICA · DISCOVER EDUCATION</span>
          <div class="research-editorial-content">
            <div class="discover-cover" aria-label="Portada de la revista Discover Education, de Springer Nature">
              <span class="discover-cover-fallback" aria-hidden="true">Discover<br />Education</span>
              <img src="https://media.springernature.com/w500/springer-static/cover/journal/44217.jpg" alt="Portada de la revista Discover Education (Springer Nature)" loading="lazy" decoding="async" onerror="this.style.display='none'" />
            </div>
            <h3>{otherInitiatives[0].title}</h3>
            <p>{otherInitiatives[0].subtitle}</p>
            <p class="editorial-description">Perspectives crítiques sobre educació, democràcia i justícia social.</p>
          </div>
          <strong>Descobrir la col·lecció temàtica ↗</strong>
        </a>
      </div>
      <div class="research-mini-list" id="mes-projectes" aria-label="Altres projectes de recerca">
        {researchProjects.slice(1).map(p=><article class="research-mini"><div><span class="mini">{p.period} · {p.code}</span><h3>{p.title}</h3><p>{p.description}</p></div><span class="research-role">{p.role}</span></article>)}
      </div>

      <DiscoProject />
      <a class="research-to-practice" href="#transferencia">...que connecta amb la pràctica <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <section class="section practice-section practice-standalone" id="transferencia">
    <div class="container">
        <div class="section-head">
          <div><div class="eyebrow">Transferència i formació</div><h2 class="section-title">...que connecta<br/>amb la pràctica</h2></div>
          <p>La formació del professorat i el debat entre l'escola i la universitat són parts essencials de la recerca educativa.</p>
        </div>
        <div class="practice-grid">
          <a class="practice-card practice-mooc" href={otherInitiatives[1].url} target="_blank" rel="noopener noreferrer">
            <span class="mini">FORMACIÓ OBERTA · COURSERA</span>
            <div class="practice-brand" aria-label="Coursera"><img src="/images/coursera-symbol.svg" alt="" width="43" height="43" loading="lazy" decoding="async" /><span class="practice-brand-wordmark" aria-hidden="true">coursera</span></div>
            <div class="practice-card-copy">
              <h3>La formación del pensamiento crítico en la era digital</h3>
              <p>MOOC de la UAB sobre literacitat crítica, ciutadania i educació democràtica, del qual soc codirector i docent.</p>
              <strong>Explorar el curs ↗</strong>
            </div>
          </a>
          <a class="practice-card practice-jornades" href={jornades2027.url} target="_blank" rel="noopener noreferrer">
            <span class="mini">JORNADES INTERNACIONALS · UAB</span>
            <div class="practice-event-visual"><div class="practice-event-date"><strong>{jornades2027.edition}</strong><span>27–29 GENER<br />2027 · UAB</span></div><span class="practice-event-art"><img src="https://www.uab.cat/ca/didactica-llengua-literatura-ciencies-socials/img/illustracio-tres-columnes-classiques-grups-persones-central-soste-planeta-terra-color-laterals-apareixen-blanc-negre-simbolitzant-leducacio-social-diversitat-global/opcio.jpg" alt="Imatge original de les Jornades: la Terra damunt una columna i un grup de persones" width="500" height="277" loading="lazy" decoding="async" /></span></div>
            <div class="practice-card-copy">
              <h3>XXIII Jornades Internacionals de Recerca en Didàctica de les Ciències Socials</h3>
              <p><strong>{jornades2027.theme}.</strong> {jornades2027.subtitle}.</p>
              <p>Coordinació de les Jornades de Didàctica de les Ciències Socials a la UAB.</p>
              <strong>Web de les Jornades ↗</strong>
            </div>
          </a>
        </div>
        <TeacherResources />
        <PracticeMaterials />
        <a class="practice-to-videos" href="#docencia">Veure també les intervencions en vídeo <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <TeachingVideoGallery />

  <section class="section research-networks" id="xarxes-academiques">
    <div class="container">
      <div class="section-head"><div><div class="eyebrow">Recerca col·lectiva i edició científica</div><h2 class="section-title">Compartir coneixement.<br/>Construir comunitat.</h2></div></div>
      <div class="network-grid">
        <article class="network-feature gredics-feature">
          <div class="network-topline">GRUP DE RECERCA · UAB</div>
          <div class="gredics-identity">
            <img class="gredics-official-logo" src={to('images/gredics-logo.svg')} alt="Logotip de GREDICS, Grup de Recerca en Didàctica de les Ciències Socials" width="654" height="180" loading="lazy" decoding="async" />
          </div>
          <h3>Grup de Recerca en Didàctica de les Ciències Socials</h3>
          <p>Recerca sobre educació per a la ciutadania, pensament crític, història, problemes socials i cultura democràtica a la Universitat Autònoma de Barcelona.</p>
          <div class="network-actions">
            <a href={profile.gredics} target="_blank" rel="noopener noreferrer">Web de GREDICS ↗</a>
            <a href={profile.gredicsProfile} target="_blank" rel="noopener noreferrer">El meu perfil ↗</a>
          </div>
        </article>
        <article class="network-feature eccss-feature">
          <div class="eccss-cover-frame">
            <img src="https://www.uab.cat/ca/didactica-llengua-literatura-ciencies-socials/img/r/revista.jpg" alt="Portada de la revista Enseñanza de las Ciencias Sociales, número 23(1), 2025" loading="lazy" decoding="async"/>
          </div>
          <div class="eccss-content">
            <div class="network-topline">REVISTA CIENTÍFICA · ACTIVITAT EDITORIAL</div>
            <h3>Enseñanza de las Ciencias Sociales</h3>
            <p>Revista d'investigació en didàctica de la geografia, la història i les ciències socials. Hi participo com a director adjunt.</p>
            <a href={otherInitiatives[2].url} target="_blank" rel="noopener noreferrer">Visitar la revista ↗</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="lab-banner" id="laboratori">
    <div class="container lab-grid">
      <div><div class="eyebrow">Conceptes · Preguntes · Activitats</div><h2>Laboratori de<br/><em>Pensament Crític.</em></h2><p>Qüestionar allò que donem per fet, escoltar mirades diverses, comprendre les desigualtats i actuar per transformar la realitat.</p><a class="btn" href="#activitats-laboratori">Explorar les quatre dimensions <span aria-hidden="true">↗</span></a></div>
      <div class="lab-art" aria-hidden="true"><div class="lab-orbit"></div><div class="lab-orbit two"></div><div class="lab-main">¿</div><span class="lab-caption">OBSERVAR / CONTRASTAR / ARGUMENTAR / ACTUAR</span></div>
    </div>
    <div class="container lab-prompts" id="activitats-laboratori" aria-label="Quatre dimensions de la literacitat crítica">
      {criticalLiteracyDimensions.map(d => (
        <article class="lab-prompt">
          <h3>{d.title}</h3>
          <p>{d.description}</p>
        </article>
      ))}
    </div>
    <div class="container lab-source">
      <small>Font: {criticalLiteracyCitation.authors} ({criticalLiteracyCitation.year}). «{criticalLiteracyCitation.title}». <cite>{criticalLiteracyCitation.journal}</cite>, {criticalLiteracyCitation.volume}, {criticalLiteracyCitation.pages}.</small>
    </div>
    <div class="container"><CriticalReadingCards /></div>
  </section>

  <section class="section about-section" id="sobre-mi">
    <div class="container about-grid">
      <div class="about-portrait-column">
        <div class="eyebrow">Sobre mi</div>
        <h2 class="section-title">Una mica sobre mi.</h2>
        <div class="about-identity">
          <figure class="about-photo"><img src={to('images/jordi-castellvi-retrat.webp')} alt="Retrat de Jordi Castellví Mata" width="700" height="875" loading="lazy" decoding="async" /></figure>
          <div class="about-personal-copy">
            <p class="lead">Treballo a la UAB, on faig classes de didàctica de les ciències socials i participo en projectes de recerca educativa. Bona part de la meva feina gira al voltant de la formació de mestres i de com connectar l'escola amb els debats del nostre temps.</p>
          </div>
        </div>
      </div>
      <div class="about-panel">
        <h3 class="panel-title">Formació acadèmica</h3>
        <div class="panel-item"><a href="https://www.uab.cat/ca/doctorats/educacio" target="_blank" rel="noopener noreferrer">Doctorat en Educació <span aria-hidden="true">↗</span></a><small>Universitat Autònoma de Barcelona (UAB)</small></div>
        <div class="panel-item"><a href="https://www.uab.cat/web/estudiar/l-oferta-de-masters-oficials/informacio-general/recerca-en-educacio-1096480139517.html?param1=1345648391191" target="_blank" rel="noopener noreferrer">Màster Universitari en Recerca en Educació <span aria-hidden="true">↗</span></a><small>Universitat Autònoma de Barcelona (UAB)</small></div>
        <div class="panel-item"><a href="https://web.ub.edu/ca/web/estudis/w/grau-g1016" target="_blank" rel="noopener noreferrer">Grau en Història <span aria-hidden="true">↗</span></a><small>Universitat de Barcelona (UB)</small></div>
        <div class="panel-item"><a href="https://educ.ulpgc.es/estudios/grados/educacion-primaria" target="_blank" rel="noopener noreferrer">Grau en Educació Primària <span aria-hidden="true">↗</span></a><small>Universitat de Las Palmas de Gran Canaria (ULPGC)</small></div>
        <a class="panel-link" href={profile.uab} target="_blank" rel="noopener noreferrer">Visitar el meu perfil acadèmic a la UAB ↗</a>
      </div>
    </div>
    <div class="container"><ThesisSpotlight /></div>
  </section>

  <section class="contact-strip" id="contacte">
    <div class="container contact-inner"><div><span class="eyebrow">Contacte i col·laboracions</span><h2>Parlem-ne.</h2></div><a class="btn" href={'mailto:'+profile.email}>Escriu-me <span class="contact-email">{profile.email}</span> <span aria-hidden="true">↗</span></a></div>
  </section>
</Base>
<style>
.hero{background:var(--paper);overflow:hidden}
.hero-grid{display:block;padding-top:clamp(95px,9vw,154px);padding-bottom:clamp(84px,8vw,140px)}
.hero-copy{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;text-align:center}
.hero-copy .eyebrow{justify-content:center}
.hero h1{font:650 clamp(64px,8.2vw,126px)/1.04 'Manrope',Arial,sans-serif;letter-spacing:-.079em;margin:34px 0 32px;white-space:normal;text-wrap:balance}
.hero h1 span{color:var(--red)}
.hero .lead{max-width:800px;font-size:clamp(18px,1.55vw,22px);line-height:1.65;margin-inline:auto}
.hero-actions{display:flex;align-items:center;justify-content:center;gap:29px;flex-wrap:wrap;margin-top:24px}
.hero-foot{border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:20px;padding:20px 0;font-size:10px;letter-spacing:.1em;font-weight:800;color:var(--muted)}
.hero-foot a{color:var(--cyan)}
.topics-section{background:var(--white)}
.topics-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}
.topic-card{border:1px solid var(--line);padding:27px 26px 25px;min-height:318px;display:flex;flex-direction:column;position:relative;overflow:hidden;background:var(--offwhite);transition:transform .2s,border-color .2s}
.topic-card:hover{transform:translateY(-4px);border-color:var(--line-strong)}
.topic-card:nth-child(2){background:var(--cyan-pale)}.topic-card:nth-child(3){background:var(--rose)}.topic-card:nth-child(4){background:var(--offwhite)}
.topic-top{display:flex;justify-content:space-between;align-items:center;color:var(--cyan);font-weight:800;font-size:11px;letter-spacing:.13em}
.topic-asterisk{font-size:27px;color:var(--red)}
.topic-card h3{font:650 clamp(20px,1.65vw,24px)/1.23 'Manrope',sans-serif;letter-spacing:-.055em;margin:38px 0 13px}
.topic-card p{font-size:13px;line-height:1.7;color:var(--muted);margin-bottom:19px}
.topic-card small{font-size:10px;letter-spacing:.09em;font-weight:800;color:var(--cyan);margin-top:auto}
.list-foot{font-size:12px;color:var(--muted);margin:23px 0 0}.list-foot a{color:var(--cyan);font-weight:800}
.projects-section{background:var(--paper)}
.project-grid{display:grid;grid-template-columns:1.22fr .78fr;gap:17px}
.project-feature{background:var(--cyan);color:var(--white);min-height:480px;position:relative;overflow:hidden;padding:31px 36px;display:flex;flex-direction:column;justify-content:space-between}
.project-meta{display:flex;justify-content:space-between;gap:15px;letter-spacing:.12em;font-weight:800;font-size:10px;color:var(--on-dark)}
.project-content{position:relative;z-index:1;max-width:500px}
.project-code{font-size:11px;color:var(--red-light);font-weight:800;letter-spacing:.1em}
.project-content h3{font:650 clamp(28px,3vw,44px)/1.14 'Manrope',sans-serif;letter-spacing:-.058em;margin:20px 0}
.project-content p{max-width:470px;font-size:15px;line-height:1.75;color:var(--on-dark)}
.project-link{display:inline-block;margin-top:20px;border-bottom:1px solid var(--red-light);padding-bottom:8px;font-size:13px;font-weight:800}
.project-circle{position:absolute;width:400px;height:400px;border:1px solid var(--cyan-line-alpha);border-radius:50%;right:-170px;top:-70px;pointer-events:none}
.project-funding{position:relative;z-index:2;align-self:stretch;margin-top:24px;background:#fff;color:var(--ink);padding:15px 18px 12px;border:1px solid rgba(255,255,255,.65);min-width:0}
.project-funding-kicker{display:block;color:var(--cyan);font:800 9px/1.5 'DM Sans',Arial,sans-serif;letter-spacing:.11em}
.project-funding-logos{position:relative;width:100%;height:108px;margin:9px auto 4px;display:grid;place-items:center;overflow:hidden;background:#fff}
.project-funding-logos img{display:block;position:absolute;inset:0;width:100%;height:100%;object-fit:contain;background:#fff}
.project-funding-fallback{font:800 clamp(10px,1.2vw,13px)/1.55 'Manrope',Arial,sans-serif;color:var(--cyan);text-align:center;letter-spacing:.015em}
.project-funding-fallback span{color:var(--red)}
.project-funding-credit{display:block;font-size:9px;line-height:1.45;color:var(--muted);text-align:center}
@media(max-width:760px){.project-funding{margin-top:24px;padding:13px 13px 11px}.project-funding-logos{height:84px}.project-funding-kicker{font-size:8px;letter-spacing:.07em}}
@media(max-width:400px){.project-funding-logos{height:68px}.project-funding-credit{font-size:8px}}
.initiative-stack{display:grid;grid-template-rows:1fr 1fr;gap:17px}
.initiative{padding:30px;background:var(--rose);border:1px solid var(--rose-line);display:flex;flex-direction:column}
.initiative.mooc{background:var(--cyan-pale);border-color:var(--line)}
.initiative>span{font-size:10px;letter-spacing:.12em;color:var(--red);font-weight:800}
.initiative h3{font:650 25px/1.23 'Manrope',sans-serif;letter-spacing:-.045em;margin:15px 0 9px}
.initiative p{font-size:13px;color:var(--muted);line-height:1.5;margin:0}
.initiative strong{font-size:12px;color:var(--cyan);margin-top:auto;padding-top:15px}
.initiative:hover h3{color:var(--red)}
.under-projects{display:flex;justify-content:space-between;gap:25px;flex-wrap:wrap;margin-top:30px}
.lab-banner{background:var(--navy);color:var(--white);padding:93px 0;overflow:hidden}
.lab-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:8%;align-items:center}
.lab-banner .eyebrow{color:var(--on-dark)}
.lab-banner h2{font:650 clamp(43px,5.5vw,77px)/1.09 'Manrope',sans-serif;letter-spacing:-.067em;margin:24px 0}
.lab-banner em{font-style:normal;color:var(--red-light)}
.lab-banner p{font-size:17px;line-height:1.7;color:var(--on-dark);max-width:520px;margin-bottom:31px}
.lab-banner .btn{background:var(--red-light);color:var(--ink)}
.lab-banner .btn:hover{background:var(--red-light-hover)}
.lab-art{height:360px;position:relative;display:grid;place-items:center}
.lab-orbit{position:absolute;height:305px;width:305px;border:2px solid var(--line-strong);border-radius:50%;transform:rotate(-20deg)}
.lab-orbit.two{height:240px;width:390px;border-color:var(--red-light);transform:rotate(35deg)}
.lab-main{font:800 235px/1 'Manrope',sans-serif;color:var(--red-light);transform:rotate(17deg);position:relative;z-index:1}
.lab-caption{position:absolute;bottom:0;left:0;color:var(--on-dark);font-size:10px;letter-spacing:.12em;font-weight:700}
.about-section{background:var(--white)}
.about-grid{display:grid;grid-template-columns:1fr .75fr;gap:12%;align-items:center}
.about-section h2{margin:20px 0}
.about-section h2 span{color:var(--red)}
.about-section .lead{max-width:620px;font-size:17px;margin:0 0 32px}
.about-identity{display:grid;grid-template-columns:172px minmax(0,1fr);align-items:start;gap:23px;min-width:0}
