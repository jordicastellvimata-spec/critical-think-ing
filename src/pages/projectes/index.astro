---
import Base from '../../layouts/Base.astro';
import FinancialEducationCourse from '../../components/FinancialEducationCourse.astro';
import EditorialActivities from '../../components/EditorialActivities.astro';
import ScientificConferences from '../../components/ScientificConferences.astro';
import { profile, researchProjects, otherInitiatives, jornades2027 } from '../../data/site';
const root=import.meta.env.BASE_URL.replace(/\/$/,''); const to=(s='')=>root+'/'+s.replace(/^\//,'');
---
<Base title="Projectes i iniciatives" active="projects" description="Projectes de recerca, coordinació editorial i formació oberta de Jordi Castellví Mata.">
  <section class="page-hero"><div class="container"><div class="eyebrow">Recerca · Edició · Transferència</div><h1 class="page-title">Recerca i projectes<span>.</span></h1><p class="lead">Investigacions sobre cultura democràtica, ciutadania crítica i futurs, juntament amb iniciatives de formació i edició científica.</p></div></section>
  <section class="section research-section"><div class="container">
    <div class="section-head"><div><div class="eyebrow">Investigació</div><h2 class="section-title">Projectes de recerca.</h2></div></div>
    <div class="research-list">{researchProjects.map(p=><article class="research-item"><div class="research-year"><strong>{p.period}</strong><span>{p.status}</span></div><div><span class="tag">{p.code}</span><h3>{p.title}</h3><p>{p.description}</p><small>{p.role}</small></div></article>)}</div>
    <div class="group-box"><div class="group-identity"><img class="group-logo" src={to('images/gredics-logo.svg')} alt="Logotip de GREDICS" width="654" height="180" loading="lazy" decoding="async" /><div><span class="mini">Grup de recerca · UAB</span><h3>GREDICS</h3><p>Grup de Recerca en Didàctica de les Ciències Socials de la Universitat Autònoma de Barcelona.</p></div></div><a class="btn" href={profile.gredics} target="_blank" rel="noopener noreferrer">Visitar GREDICS ↗</a></div>
  </div></section>
  <section class="section"><div class="container">
    <EditorialActivities standalone={true} />
    <ScientificConferences standalone={true} />
  </div></section>
  <section class="section section-alt"><div class="container">
    <div class="section-head"><div><div class="eyebrow">Edició científica · Formació · Jornades</div><h2 class="section-title">Formació permanent</h2></div></div>
    <div class="initiative-list">
      {otherInitiatives.slice(1,2).map(item=><article class="initiative-card"><span class="mini">{item.eyebrow}</span><h3>{item.title}</h3><p class="subtitle">{item.subtitle}</p><p>{item.description}</p><a class="text-link" href={item.url} target="_blank" rel="noopener noreferrer">{item.linkText} ↗</a></article>)}
      
    </div>
    <FinancialEducationCourse />
  </div></section>
</Base>
<style>
.page-hero h1 span{color:var(--red)}.research-list{border-top:1px solid var(--line)}.research-item{display:grid;grid-template-columns:195px 1fr;gap:35px;padding:38px 0;border-bottom:1px solid var(--line)}.research-year{display:flex;flex-direction:column;gap:14px}.research-year strong{font:750 25px/1.3 'Manrope',sans-serif;color:var(--red);letter-spacing:-.04em}.research-year span{font-size:10px;font-weight:800;letter-spacing:.12em;color:var(--muted)}.research-item h3{font:650 29px/1.2 'Manrope',sans-serif;letter-spacing:-.055em;max-width:810px;margin:10px 0 14px}.research-item p{color:var(--muted);line-height:1.75;font-size:15px;max-width:730px}.research-item small{font-size:12px;font-weight:800;color:var(--cyan)}.group-box{margin-top:42px;background:var(--cyan);color:var(--white);padding:34px;display:flex;align-items:center;justify-content:space-between;gap:25px}.group-box h3{font:700 var(--type-item) 'Manrope',sans-serif;letter-spacing:-.07em;margin:9px 0}.group-box p{color:var(--on-dark);line-height:1.6;font-size:14px;margin:0;max-width:570px}.group-box .mini{color:var(--on-dark)}.group-box .btn{background:var(--red-light);color:var(--ink)}.initiative-list{display:grid;grid-template-columns:repeat(2,1fr);gap:17px}.initiative-card{padding:33px 28px;background:var(--white);min-height:390px;border:1px solid var(--line);display:flex;flex-direction:column}.initiative-card:nth-child(2){background:var(--rose);border-color:var(--rose-line)}.initiative-card .mini{color:var(--red)}.initiative-card h3{font:650 27px/1.27 'Manrope',sans-serif;letter-spacing:-.05em;margin:20px 0 8px}.initiative-card p{font-size:14px;line-height:1.7;color:var(--muted);margin:8px 0}.initiative-card p.subtitle{font-size:12px;font-weight:800;color:var(--cyan)}.initiative-card .text-link{margin-top:auto;padding-top:25px}
@media(max-width:900px){.initiative-list{grid-template-columns:1fr}.initiative-card{min-height:0}}@media(max-width:760px){.research-item{grid-template-columns:1fr;gap:15px}.group-box{flex-direction:column;align-items:flex-start}}

.group-identity{display:flex;align-items:center;gap:27px;min-width:0;flex:1}
.group-logo{width:min(33%,210px);height:auto;max-height:94px;object-fit:contain;background:var(--white);padding:14px;border-radius:3px;flex-shrink:0}
.jornades-project{background:var(--cyan-pale)}
.jornades-project .subtitle{font-weight:800}
@media(max-width:760px){.group-identity{flex-direction:column;align-items:flex-start;gap:20px}.group-logo{width:100%;max-width:265px}.initiative-list{grid-template-columns:1fr}}
</style>
