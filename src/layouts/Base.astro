---
import { profile } from '../data/site';
const {title='Jordi Castellví Mata', description='Pensament crític, educació democràtica i didàctica de les ciències socials.', active=''} = Astro.props;
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (p='') => root + '/' + p.replace(/^\//,'');
const nav = [
  { label:'Inici', path:'', key:'home' },
  { label:'Sobre mi', path:'sobre-mi/', key:'about' },
  { label:'Publicacions', path:'publicacions/', key:'pubs' },
  { label:'Projectes', path:'projectes/', key:'projects' },
  { label:'Laboratori', path:'laboratori/', key:'lab' },
];
---
<!doctype html>
<html lang="ca">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#fcfbf7" />
  <meta name="description" content={description} />
  <meta property="og:title" content={title + ' | critical-think.ing'} />
  <meta property="og:description" content={description} />
  <title>{title} | critical-think.ing</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="site-header">
    <header class="container header-content">
      <a class="wordmark" href={url('')} aria-label="Inici de critical-think.ing"><span class="mark">✳</span><span>critical<span class="wordmark-accent">-</span>think<span class="wordmark-accent">.</span>ing</span></a>
      <nav class="desktop-nav" aria-label="Navegació principal">{nav.map(item=><a href={url(item.path)} aria-current={active===item.key?'page':undefined}>{item.label}</a>)}</nav>
      <a class="desktop-contact" href={'mailto:'+profile.email}>Contacte <span aria-hidden="true">↗</span></a>
      <details class="mobile-nav">
        <summary aria-label="Obrir el menú">Menú <span aria-hidden="true">☰</span></summary>
        <nav aria-label="Navegació mòbil">{nav.map(item=><a href={url(item.path)}>{item.label}</a>)}<a href={'mailto:'+profile.email}>Contacte ↗</a></nav>
      </details>
    </header>
  </div>
  <main id="main"><slot /></main>
  <footer class="site-footer">
    <div class="container footer-columns">
      <div><a class="footer-mark" href={url('')}>critical-think.ing</a><p>Jordi Castellví Mata<br/>Recerca, educació i pensament crític</p></div>
      <div class="footer-links"><a href={profile.uab} target="_blank" rel="noreferrer">Perfil UAB ↗</a><a href={profile.orcid} target="_blank" rel="noreferrer">ORCID ↗</a><a href={profile.gredics} target="_blank" rel="noreferrer">GREDICS ↗</a></div>
      <div class="footer-email"><span>CONTACTE ACADÈMIC</span><a href={'mailto:'+profile.email}>{profile.email} ↗</a><small>© {new Date().getFullYear()} Jordi Castellví Mata</small></div>
    </div>
  </footer>
</body>
</html>
<style is:global>
:root{font-family:'DM Sans',Arial,sans-serif;color:#172d35;background:#fcfbf7;font-synthesis:none;font-weight:400}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;min-width:320px}
a{text-decoration:none;color:inherit}
button{font:inherit}
::selection{background:#f7c19e;color:#172d35}
.container{width:min(100% - 9vw,1360px);margin-inline:auto}
.site-header{background:#fcfbf7;border-bottom:1px solid #dce3e3;position:relative;z-index:5}
.header-content{min-height:92px;display:flex;align-items:center;gap:32px}
.wordmark{display:flex;align-items:center;gap:11px;font:800 20px/1 'Manrope',Arial,sans-serif;letter-spacing:-.075em;white-space:nowrap}
.mark{width:35px;height:35px;border-radius:50%;background:#215e81;color:#fff;display:grid;place-items:center;font:600 24px/1 'DM Sans',sans-serif}
.wordmark-accent{color:#d95f37}
.desktop-nav{display:flex;align-items:center;gap:26px;margin-left:auto}
.desktop-nav a{font-size:12px;font-weight:700;padding:10px 0;border-bottom:2px solid transparent;white-space:nowrap}
.desktop-nav a:hover,.desktop-nav a[aria-current=page]{border-color:#d95f37;color:#125e82}
.desktop-contact{font-size:12px;font-weight:800;white-space:nowrap;color:#fff;background:#1c5879;padding:13px 17px}
.desktop-contact:hover,.btn:hover{background:#10415e}
.desktop-contact span{margin-left:10px}
.mobile-nav{display:none}
.eyebrow{display:flex;align-items:center;gap:11px;font-size:11px;letter-spacing:.16em;font-weight:800;text-transform:uppercase;color:#276385}
.eyebrow:before{content:'';height:8px;width:8px;flex:0 0 8px;background:#dd6238;border-radius:50%}
h1,h2,h3,h4,p{margin-top:0}
.display{font:650 clamp(56px,6.6vw,105px)/1.04 'Manrope',Arial,sans-serif;letter-spacing:-.079em}
.section-title{font:650 clamp(37px,4.3vw,61px)/1.11 'Manrope',Arial,sans-serif;letter-spacing:-.068em}
.page-title{font:650 clamp(51px,6vw,83px)/1.09 'Manrope',Arial,sans-serif;letter-spacing:-.073em}
.lead{font-size:19px;line-height:1.68;color:#46606b}
.muted{color:#5c6d74}
.mini{font-size:11px;letter-spacing:.12em;font-weight:800;text-transform:uppercase}
.btn{display:inline-flex;align-items:center;justify-content:space-between;gap:25px;background:#1c5879;color:#fff;padding:18px 23px;font-size:12px;font-weight:800;transition:background .2s,transform .2s}
.btn:hover{transform:translateY(-2px)}
.btn.ghost{color:#184f6d;background:transparent;border:1px solid #a8c1ca}
.btn.ghost:hover{background:#e5f1f6}
.text-link{display:inline-flex;align-items:center;gap:14px;font-weight:800;font-size:13px;color:#176086}
.text-link:hover{text-decoration:underline;text-underline-offset:5px}
.card{background:#fff;border:1px solid #dbe4e7;padding:28px;box-shadow:0 8px 28px rgba(20,58,72,.035)}
.card a:hover{text-decoration:underline}
.section{padding:103px 0}
.section-alt{background:#eaf3f6}
.section-light{background:#fff}
.section-head{display:flex;align-items:end;justify-content:space-between;gap:35px;margin-bottom:38px}
.section-head h2{margin:15px 0 0}
.section-head p{max-width:320px;color:#59717b;font-size:14px;line-height:1.75;margin:0}
.site-footer{background:#123a50;color:#fff;padding:58px 0 65px}
.footer-columns{display:grid;grid-template-columns:1.25fr .7fr 1fr;gap:45px}
.footer-mark{font:800 21px/1 'Manrope',sans-serif;letter-spacing:-.06em}
.site-footer p{color:#cfdee6;font-size:13px;line-height:1.8;margin:20px 0 0}
.footer-links{display:flex;flex-direction:column;gap:14px;font-weight:600;font-size:13px}
.footer-links a:hover,.footer-email a:hover{color:#f9b18c}
.footer-email{display:flex;flex-direction:column;align-items:flex-start;gap:17px}
.footer-email span,.footer-email small{font-size:10px;letter-spacing:.1em;color:#aec8d7}
.footer-email a{font-size:14px;font-weight:700;overflow-wrap:anywhere}
.page-hero{padding:96px 0 75px;border-bottom:1px solid #dae5e7;background:#f7fafb}
.page-hero h1{margin:22px 0 20px;max-width:1070px}
.page-hero .lead{max-width:800px;margin:0}
.paper-list{border-top:1px solid #cddce3}
.paper{display:grid;grid-template-columns:85px 1fr 35px;gap:25px;border-bottom:1px solid #cddce3;padding:27px 0}
.paper .year{font:700 15px 'Manrope',sans-serif;color:#be5d3e}
.paper h3{font:650 clamp(17px,1.75vw,23px)/1.4 'Manrope',sans-serif;letter-spacing:-.035em;margin:0 0 10px}
.paper p{font-size:13px;color:#5d727d;line-height:1.6;margin:0}
.paper .arrow{font-size:22px;color:#1d6387}
.paper:hover h3{color:#17638b}
.tag{font-size:10px;font-weight:800;letter-spacing:.1em;color:#226387;text-transform:uppercase}
@media(max-width:1050px){.desktop-nav{gap:16px}.desktop-contact{display:none}.footer-columns{grid-template-columns:1fr 1fr}}
@media(max-width:760px){.container{width:min(100% - 40px,1360px)}.header-content{min-height:75px}.wordmark{font-size:17px}.mark{width:30px;height:30px;font-size:20px}.desktop-nav{display:none}.mobile-nav{display:block;margin-left:auto;position:relative}.mobile-nav summary{cursor:pointer;list-style:none;color:#154e6e;font-size:13px;font-weight:800}.mobile-nav summary::-webkit-details-marker{display:none}.mobile-nav summary span{margin-left:7px}.mobile-nav nav{position:absolute;right:0;top:36px;min-width:220px;background:#fff;box-shadow:0 16px 30px rgba(15,55,73,.14);border:1px solid #d4e0e5;padding:15px;display:flex;flex-direction:column}.mobile-nav a{padding:10px;font-size:14px}.display{font-size:clamp(47px,11vw,75px)}.section{padding:72px 0}.section-head{display:block}.section-head p{margin-top:20px}.footer-columns{grid-template-columns:1fr;gap:35px}.paper{grid-template-columns:55px 1fr 18px;gap:10px}.page-hero{padding:71px 0 60px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{transition-duration:0s!important}}
</style>
