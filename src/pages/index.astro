---
import Base from '../layouts/Base.astro';
import JournalCover from '../components/JournalCover.astro';
import FeaturedBooks from '../components/FeaturedBooks.astro';
import TeachingVideoGallery from '../components/TeachingVideoGallery.astro';
import { criticalLiteracyDimensions, criticalLiteracyCitation } from '../data/criticalLiteracyDimensions';
import {profile, themes, publications, researchProjects, otherInitiatives, jornades2027} from '../data/site';
const root=import.meta.env.BASE_URL.replace(/\/$/,'');
const to=(s='')=>root+'/'+s.replace(/^\//,'');
---
<Base title="Jordi Castellví Mata" active="home" description="Espai acadèmic de Jordi Castellví Mata: pensament crític, educació democràtica, publicacions, projectes i divulgació.">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy scroll-transition-hero">
        <div class="eyebrow">Jordi Castellví Mata · Universitat Autònoma de Barcelona</div>
        <h1 class="display">Llegir el món.<br /><span>Escriure el futur.</span></h1>
        <p class="lead">Investigo com l'educació pot ajudar-nos a qüestionar allò que donem per fet, comprendre críticament el present i imaginar futurs més justos.</p>
        <div class="hero-actions">
          <a class="btn" href="#publicacions">Explorar publicacions <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="#sobre-mi">Conèixer la meva trajectòria <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
    <div class="container hero-foot"><span>RECERCA · DOCÈNCIA · TRANSFERÈNCIA</span><span>CRITICAL THINKING / SOCIAL SCIENCES EDUCATION</span><a href="#recerca">DESCOBREIX MÉS ↓</a></div>
  </section>

  <section class="section topics-section" id="recerca">
    <div class="container">
      <div class="section-head">
        <div><div class="eyebrow">Línies de recerca</div><h2 class="section-title">Les preguntes<br/>que ens mouen.</h2></div>
        <p>Pensament crític, participació democràtica i literacitat digital per interpretar els problemes socials del present.</p>
      </div>
      <div class="topics-grid">
        {themes.map(t=><article class="topic-card"><div class="topic-top"><span>{t.number} / 04</span><span class="topic-asterisk">✳</span></div><h3>{t.name}</h3><p>{t.detail}</p><small>{t.english}</small></article>)}
      </div>
    </div>
  </section>

  <section class="section section-alt" id="publicacions">
    <div class="container">
      <div class="section-head">
        <div><div class="eyebrow">Producció científica · Revistes indexades</div><h2 class="section-title">Idees que es<br/>converteixen en recerca.</h2></div>
      </div>
      <FeaturedBooks />
      <h3 class="articles-section-title">Articles de recerca</h3>
      <div class="paper-list">
        {publications.map(p=><a class="paper paper-visual" href={p.url} target="_blank" rel="noopener noreferrer" aria-label={p.title + '. Obrir la publicació'}><span class="year">{p.year}</span><JournalCover venue={p.venue}/><div class="paper-copy"><div class="tag">{p.venue} <span class="pub-type">· {p.indexing.join(' · ')}</span></div><h3>{p.title}</h3><p>{p.authors}</p></div><span class="arrow" aria-hidden="true">↗</span></a>)}
      </div>
      <p class="list-foot"><a href={profile.uab} target="_blank" rel="noopener noreferrer">Portal de Recerca de la UAB ↗</a></p>
    </div>
  </section>

  <section class="section projects-section" id="projectes">
    <div class="container">
      <div class="section-head">
        <div><div class="eyebrow">Projectes i activitat científica</div><h2 class="section-title">Recerca...</h2></div>
        <p>Educació democràtica, ciutadania i pensament crític: projectes col·lectius que busquen comprendre la realitat i transformar l'educació.</p>
      </div>
      <div class="project-grid">
        <article class="project-feature">
          <div class="project-meta"><span>PROJECTE DE RECERCA · EN CURS</span><span>{researchProjects[0].period}</span></div>
          <div class="project-content"><span class="project-code">{researchProjects[0].code}</span><h3>{researchProjects[0].title}</h3><p>{researchProjects[0].description}</p><a href="#mes-projectes" class="project-link">Altres projectes de recerca <span aria-hidden="true">↗</span></a></div>
          <div class="project-circle" aria-hidden="true"></div>
        </article>
        <a class="initiative editorial-research" href={otherInitiatives[0].url} target="_blank" rel="noopener noreferrer">
          <span>EDICIÓ CIENTÍFICA · DISCOVER EDUCATION</span>
          <div class="research-editorial-content">
            <span class="editorial-symbol" aria-hidden="true">✳</span>
            <h3>{otherInitiatives[0].title}</h3>
            <p>{otherInitiatives[0].subtitle}</p>
            <p class="editorial-description">Perspectives crítiques sobre educació, democràcia i justícia social.</p>
          </div>
          <strong>Descobrir la col·lecció temàtica ↗</strong>
        </a>
      </div>
      <div class="research-mini-list" id="mes-projectes" aria-label="Altres projectes de recerca">
        {researchProjects.slice(1).map(p=><article class="research-mini"><div><span class="mini">{p.period} · {p.code}</span><h3>{p.title}</h3><p>{p.description}</p></div><span class="research-role">{p.role}</span></article>)}
      </div>

      <a class="research-to-practice" href="#transferencia">...que connecta amb la pràctica <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <section class="section practice-section practice-standalone" id="transferencia">
    <div class="container">
        <div class="section-head">
          <div><div class="eyebrow">Transferència i formació</div><h2 class="section-title">...que connecta<br/>amb la pràctica</h2></div>
          <p>La formació del professorat i el debat entre l'escola i la universitat són parts essencials de la recerca educativa.</p>
        </div>
        <div class="practice-grid">
          <a class="practice-card practice-mooc" href={otherInitiatives[1].url} target="_blank" rel="noopener noreferrer">
            <span class="mini">FORMACIÓ OBERTA · COURSERA</span>
            <div class="practice-symbol" aria-hidden="true">↗</div>
            <div class="practice-card-copy">
              <h3>La formación del pensamiento crítico en la era digital</h3>
              <p>MOOC de la UAB sobre literacitat crítica, ciutadania i educació democràtica, del qual soc codirector i docent.</p>
              <strong>Explorar el curs ↗</strong>
            </div>
          </a>
          <a class="practice-card practice-jornades" href={jornades2027.url} target="_blank" rel="noopener noreferrer">
            <span class="mini">JORNADES INTERNACIONALS · UAB</span>
            <div class="practice-event-date"><strong>{jornades2027.edition}</strong><span>{jornades2027.dates}</span></div>
            <div class="practice-card-copy">
              <h3>XXIII Jornades Internacionals de Recerca</h3>
              <p><strong>{jornades2027.theme}.</strong> {jornades2027.subtitle}.</p>
              <p>27, 28 i 29 de gener de 2027 · UAB. Coordinació de les Jornades de Didàctica de les Ciències Socials.</p>
              <strong>Web de les Jornades ↗</strong>
            </div>
          </a>
        </div>
        <a class="practice-to-videos" href="#docencia">Veure també les intervencions en vídeo <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <TeachingVideoGallery />

  <section class="section research-networks" id="xarxes-academiques">
    <div class="container">
      <div class="section-head"><div><div class="eyebrow">Recerca col·lectiva i edició científica</div><h2 class="section-title">Compartir coneixement.<br/>Construir comunitat.</h2></div></div>
      <div class="network-grid">
        <article class="network-feature gredics-feature">
          <div class="network-topline">GRUP DE RECERCA · UAB</div>
          <div class="gredics-identity">
            <img class="gredics-official-logo" src={to('images/gredics-logo.svg')} alt="Logotip de GREDICS, Grup de Recerca en Didàctica de les Ciències Socials" width="654" height="180" loading="lazy" decoding="async" />
          </div>
          <h3>Grup de Recerca en Didàctica de les Ciències Socials</h3>
          <p>Recerca sobre educació per a la ciutadania, pensament crític, història, problemes socials i cultura democràtica a la Universitat Autònoma de Barcelona.</p>
          <div class="network-actions">
            <a href={profile.gredics} target="_blank" rel="noopener noreferrer">Web de GREDICS ↗</a>
            <a href={profile.gredicsProfile} target="_blank" rel="noopener noreferrer">El meu perfil ↗</a>
          </div>
        </article>
        <article class="network-feature eccss-feature">
          <div class="eccss-cover-frame">
            <img src="https://www.uab.cat/ca/didactica-llengua-literatura-ciencies-socials/img/r/revista.jpg" alt="Portada de la revista Enseñanza de las Ciencias Sociales, número 23(1), 2025" loading="lazy" decoding="async"/>
          </div>
          <div class="eccss-content">
            <div class="network-topline">REVISTA CIENTÍFICA · ACTIVITAT EDITORIAL</div>
            <h3>Enseñanza de las Ciencias Sociales</h3>
            <p>Revista d'investigació en didàctica de la geografia, la història i les ciències socials. Hi participo com a director adjunt.</p>
            <a href={otherInitiatives[2].url} target="_blank" rel="noopener noreferrer">Visitar la revista ↗</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="lab-banner" id="laboratori">
    <div class="container lab-grid">
      <div><div class="eyebrow">Conceptes · Preguntes · Activitats</div><h2>Laboratori de<br/><em>Pensament Crític.</em></h2><p>Qüestionar allò que donem per fet, escoltar mirades diverses, comprendre les desigualtats i actuar per transformar la realitat.</p><a class="btn" href="#activitats-laboratori">Explorar les quatre dimensions <span aria-hidden="true">↗</span></a></div>
      <div class="lab-art" aria-hidden="true"><div class="lab-orbit"></div><div class="lab-orbit two"></div><div class="lab-main">¿</div><span class="lab-caption">OBSERVAR / CONTRASTAR / ARGUMENTAR / ACTUAR</span></div>
    </div>
    <div class="container lab-prompts" id="activitats-laboratori" aria-label="Quatre dimensions de la literacitat crítica">
      {criticalLiteracyDimensions.map(d => (
        <article class="lab-prompt">
          <span class="mini">{d.number} · LITERACITAT CRÍTICA</span>
          <h3>{d.title}</h3>
          <p>{d.description}</p>
        </article>
      ))}
    </div>
    <div class="container lab-source">
      <small>Font: {criticalLiteracyCitation.authors} ({criticalLiteracyCitation.year}). «{criticalLiteracyCitation.title}». <cite>{criticalLiteracyCitation.journal}</cite>, {criticalLiteracyCitation.volume}, {criticalLiteracyCitation.pages}.</small>
    </div>
  </section>

  <section class="section about-section" id="sobre-mi">
    <div class="container about-grid">
      <div><div class="eyebrow">Sobre mi</div><h2 class="section-title">Una mica sobre mi.</h2><p class="lead">Treballo a la UAB, on faig classes de didàctica de les ciències socials i participo en projectes de recerca educativa. Bona part de la meva feina gira al voltant de la formació de mestres i de com connectar l'escola amb els debats del nostre temps.</p><a class="btn ghost" href={profile.uab} target="_blank" rel="noopener noreferrer">El meu perfil acadèmic a la UAB <span aria-hidden="true">↗</span></a></div>
      <div class="about-panel">
        <div class="panel-item"><span>2019</span><p>Doctorat internacional en Educació · UAB</p></div>
        <div class="panel-item"><span>2021</span><p>Premi extraordinari de doctorat en Educació</p></div>
        <div class="panel-item"><span>2025—</span><p>Coordinació de la Unitat de Didàctica de les Ciències Socials · UAB</p></div>
        <a class="panel-link" href={profile.uab} target="_blank" rel="noopener noreferrer">Visitar el meu perfil acadèmic a la UAB ↗</a>
      </div>
    </div>
  </section>

  <section class="contact-strip" id="contacte">
    <div class="container contact-inner"><div><span class="eyebrow">Contacte i col·laboracions</span><h2>Parlem-ne.</h2></div><a class="btn" href={'mailto:'+profile.email}>Escriu-me <span class="contact-email">{profile.email}</span> <span aria-hidden="true">↗</span></a></div>
  </section>
</Base>
<style>
.hero{background:#fcfbf7;overflow:hidden}
.hero-grid{display:block;padding-top:clamp(95px,9vw,154px);padding-bottom:clamp(84px,8vw,140px)}
.hero-copy{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;text-align:center}
.hero-copy .eyebrow{justify-content:center}
.hero h1{font:650 clamp(64px,8.2vw,126px)/1.04 'Manrope',Arial,sans-serif;letter-spacing:-.079em;margin:34px 0 32px;white-space:normal;text-wrap:balance}
.hero h1 span{color:#d95f37}
.hero .lead{max-width:800px;font-size:clamp(18px,1.55vw,22px);line-height:1.65;margin-inline:auto}
.hero-actions{display:flex;align-items:center;justify-content:center;gap:29px;flex-wrap:wrap;margin-top:39px}
.hero-foot{border-top:1px solid #dce5e6;display:flex;justify-content:space-between;gap:20px;padding:20px 0;font-size:10px;letter-spacing:.1em;font-weight:800;color:#66808c}
.hero-foot a{color:#1c5d7d}
.topics-section{background:#fff}
.topics-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}
.topic-card{border:1px solid #d1e2e8;padding:27px 26px 25px;min-height:318px;display:flex;flex-direction:column;position:relative;overflow:hidden;background:#fbfdfe;transition:transform .2s,border-color .2s}
.topic-card:hover{transform:translateY(-4px);border-color:#6faac0}
.topic-card:nth-child(2){background:#edf7fb}.topic-card:nth-child(3){background:#fff3ea}.topic-card:nth-child(4){background:#e7f0ee}
.topic-top{display:flex;justify-content:space-between;align-items:center;color:#2c6d8e;font-weight:800;font-size:11px;letter-spacing:.13em}
.topic-asterisk{font-size:27px;color:#d7653f}
.topic-card h3{font:650 24px/1.2 'Manrope',sans-serif;letter-spacing:-.055em;margin:60px 0 13px}
.topic-card p{font-size:13px;line-height:1.7;color:#4e6670;margin-bottom:25px}
.topic-card small{font-size:10px;letter-spacing:.09em;font-weight:800;color:#39738e;margin-top:auto}
.list-foot{font-size:12px;color:#657b86;margin:23px 0 0}.list-foot a{color:#176084;font-weight:800}
.projects-section{background:#fcfbf7}
.project-grid{display:grid;grid-template-columns:1.22fr .78fr;gap:17px}
.project-feature{background:#195c7e;color:#fff;min-height:480px;position:relative;overflow:hidden;padding:31px 36px;display:flex;flex-direction:column;justify-content:space-between}
.project-meta{display:flex;justify-content:space-between;gap:15px;letter-spacing:.12em;font-weight:800;font-size:10px;color:#d2e8f1}
.project-content{position:relative;z-index:1;max-width:500px}
.project-code{font-size:11px;color:#f6b18e;font-weight:800;letter-spacing:.1em}
.project-content h3{font:650 clamp(28px,3vw,44px)/1.14 'Manrope',sans-serif;letter-spacing:-.058em;margin:20px 0}
.project-content p{max-width:470px;font-size:15px;line-height:1.75;color:#d3e7f0}
.project-link{display:inline-block;margin-top:20px;border-bottom:1px solid #f4be9e;padding-bottom:8px;font-size:13px;font-weight:800}
.project-circle{position:absolute;width:400px;height:400px;border:1px solid #95cada88;border-radius:50%;right:-170px;top:-70px}
.initiative-stack{display:grid;grid-template-rows:1fr 1fr;gap:17px}
.initiative{padding:30px;background:#fff3ea;border:1px solid #f0d1bf;display:flex;flex-direction:column}
.initiative.mooc{background:#e5f1f5;border-color:#cee4eb}
.initiative>span{font-size:10px;letter-spacing:.12em;color:#9b563e;font-weight:800}
.initiative h3{font:650 25px/1.23 'Manrope',sans-serif;letter-spacing:-.045em;margin:15px 0 9px}
.initiative p{font-size:13px;color:#65767d;line-height:1.5;margin:0}
.initiative strong{font-size:12px;color:#205c7a;margin-top:auto;padding-top:15px}
.initiative:hover h3{color:#c65c38}
.under-projects{display:flex;justify-content:space-between;gap:25px;flex-wrap:wrap;margin-top:30px}
.lab-banner{background:#143d54;color:#fff;padding:93px 0;overflow:hidden}
.lab-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:8%;align-items:center}
.lab-banner .eyebrow{color:#c5e0ea}
.lab-banner h2{font:650 clamp(43px,5.5vw,77px)/1.09 'Manrope',sans-serif;letter-spacing:-.067em;margin:24px 0}
.lab-banner em{font-style:normal;color:#ffa66d}
.lab-banner p{font-size:17px;line-height:1.7;color:#c6e0e9;max-width:520px;margin-bottom:31px}
.lab-banner .btn{background:#f29a66;color:#122e3f}
.lab-banner .btn:hover{background:#ffb58a}
.lab-art{height:360px;position:relative;display:grid;place-items:center}
.lab-orbit{position:absolute;height:305px;width:305px;border:2px solid #88c4d1;border-radius:50%;transform:rotate(-20deg)}
.lab-orbit.two{height:240px;width:390px;border-color:#f0a26b;transform:rotate(35deg)}
.lab-main{font:800 235px/1 'Manrope',sans-serif;color:#f8ab75;transform:rotate(17deg);position:relative;z-index:1}
.lab-caption{position:absolute;bottom:0;left:0;color:#adcbd7;font-size:10px;letter-spacing:.12em;font-weight:700}
.about-section{background:#fff}
.about-grid{display:grid;grid-template-columns:1fr .75fr;gap:12%;align-items:center}
.about-section h2{margin:20px 0}
.about-section h2 span{color:#d3603c}
.about-section .lead{max-width:620px;font-size:17px;margin:0 0 32px}
.about-panel{background:#e7f1f5;padding:30px 37px}
.panel-item{display:grid;grid-template-columns:88px 1fr;gap:18px;padding:20px 0;border-bottom:1px solid #bfd5de}
.panel-item span{font:800 21px 'Manrope',sans-serif;color:#d26640}
.panel-item p{font-size:14px;font-weight:600;line-height:1.6;margin:0}
.panel-link{display:inline-block;color:#176181;font-size:13px;font-weight:800;margin-top:25px}
.contact-strip{background:#e7f2f5;padding:67px 0}
.contact-inner{display:flex;justify-content:space-between;align-items:center;gap:30px}
.contact-inner h2{font:650 clamp(32px,4vw,55px)/1.16 'Manrope',sans-serif;letter-spacing:-.065em;margin:17px 0 0}
@media(max-width:1100px){.topics-grid{grid-template-columns:repeat(2,1fr)}.topic-card{min-height:260px}.topic-card h3{margin-top:36px}}
@media(max-width:760px){.hero-grid{padding-top:74px;padding-bottom:72px}.hero h1{font-size:clamp(41px,10.7vw,78px);line-height:1.08;margin:27px 0 27px;letter-spacing:-.075em}.hero .lead{font-size:16px;line-height:1.65}.hero-actions{flex-direction:column;gap:19px;margin-top:30px}.hero-foot{display:none}.topics-grid{grid-template-columns:1fr}.topic-card{min-height:0}.topic-card h3{margin:25px 0 13px}.project-grid,.lab-grid,.about-grid{grid-template-columns:1fr}.project-feature{min-height:400px}.initiative-stack{grid-template-rows:auto}.initiative{min-height:215px}.lab-art{height:250px}.lab-orbit{height:200px;width:200px}.lab-orbit.two{height:150px;width:270px}.lab-main{font-size:165px}.about-panel{padding:22px}.contact-inner{align-items:flex-start;flex-direction:column}.contact-inner .btn{max-width:100%;font-size:11px;overflow-wrap:anywhere}}

/* Completem la portada en una única pàgina, conservant íntegrament la paleta actual. */
.pub-type{font-weight:600;letter-spacing:.02em;color:#5b8092}
.other-outputs{margin-top:58px}
.other-outputs>.eyebrow{margin-bottom:12px}
.other-explainer{font-size:14px;color:#5d727d;line-height:1.65;margin:0 0 23px}
.research-mini-list{margin-top:32px;border-top:1px solid #c5d7df;scroll-margin-top:96px}
.research-mini{display:grid;grid-template-columns:1.35fr .55fr;gap:30px;align-items:center;border-bottom:1px solid #c5d7df;padding:22px 0}
.research-mini .mini{color:#b65a3c;font-size:10px}
.research-mini h3{font:650 20px/1.33 'Manrope',sans-serif;letter-spacing:-.04em;margin:12px 0 9px}
.research-mini p{font-size:13px;color:#56707c;line-height:1.65;margin:0}
.research-role{font-size:12px;font-weight:700;color:#236383;line-height:1.5}
.journal-initiative{margin-top:24px;background:#e5f1f5;border:1px solid #cee4eb;padding:22px 25px;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}
.journal-initiative .mini{color:#b35c3e}
.journal-initiative strong{font:650 19px/1.3 'Manrope',sans-serif;letter-spacing:-.04em}
.journal-initiative>span:last-child{font-size:12px;color:#215c7a;font-weight:700}
.lab-prompts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:52px;scroll-margin-top:96px}
.lab-prompt{border:1px solid #88b7ca;padding:28px;min-height:205px}
.lab-prompt .mini{color:#f7b58b}
.lab-prompt h3{font:650 22px/1.35 'Manrope',sans-serif;letter-spacing:-.04em;margin:22px 0 12px}
.lab-prompt p{font-size:13px;color:#c6e0e9;line-height:1.65;margin:0}
.lab-deeper{margin-top:28px}
.lab-deeper .text-link{color:#f7b58b}
.contact-email{font-weight:500;margin-left:8px}
@media(max-width:760px){.research-mini{grid-template-columns:1fr;gap:12px}.lab-prompts{grid-template-columns:1fr;margin-top:28px}.lab-prompt{min-height:0}.lab-prompt h3{margin:15px 0 9px}.contact-email{display:none}.journal-initiative{display:block}.journal-initiative>*{display:block;margin-bottom:12px}}

/* Xarxa de recerca i edició científica: mateixa paleta de la versió actual. */
.research-networks{background:#f7fafb}
.network-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;align-items:stretch}
.network-feature{min-width:0;min-height:375px;border:1px solid #d1e2e8}
.network-topline{font-size:10px;letter-spacing:.12em;font-weight:800;color:#346b84}
.gredics-feature{background:#e7f2f5;padding:34px 39px;display:flex;flex-direction:column}
.gredics-identity{display:flex;align-items:center;gap:16px;margin:24px 0 20px}
.gredics-monogram{height:80px;width:80px;flex:0 0 80px;display:grid;place-items:center;border-radius:50%;background:#165a7c;color:#fff;font:800 40px/1 'Manrope',sans-serif;letter-spacing:-.1em;position:relative}
.gredics-monogram span{font-size:22px;color:#f3a174}
.gredics-wordmark{font:800 clamp(35px,3.5vw,54px)/1 'Manrope',sans-serif;letter-spacing:-.09em;color:#154b68}
.gredics-feature h3{font:650 24px/1.25 'Manrope',sans-serif;letter-spacing:-.05em;margin:0 0 14px}
.gredics-feature p{font-size:14px;line-height:1.7;color:#4e6976;margin:0 0 23px}
.network-actions{margin-top:auto;display:flex;gap:24px;flex-wrap:wrap}
.network-actions a,.eccss-content a{font-size:12px;font-weight:800;color:#195d7f;border-bottom:1px solid currentColor;padding-bottom:5px}
.eccss-feature{display:grid;grid-template-columns:minmax(0,40%) minmax(0,60%);overflow:hidden;background:#fff}
.eccss-cover-frame{background:#dbeaf0;display:grid;place-items:center;min-height:100%;padding:25px 16px}
.eccss-cover-frame img{display:block;width:100%;height:auto;max-height:330px;object-fit:contain;box-shadow:5px 9px 18px rgba(14,43,60,.16)}
.eccss-content{padding:34px 28px;display:flex;flex-direction:column;align-items:flex-start}
.eccss-content h3{font:650 clamp(24px,2.3vw,34px)/1.18 'Manrope',sans-serif;letter-spacing:-.06em;margin:30px 0 20px}
.eccss-content p{font-size:14px;line-height:1.8;color:#506976;margin:0 0 25px}
.eccss-content a{margin-top:auto}
@media(max-width:1050px){.network-grid{grid-template-columns:1fr}.network-feature{min-height:0}.eccss-feature{min-height:310px}.eccss-cover-frame img{max-height:290px}}
@media(max-width:760px){.gredics-feature{padding:28px 23px}.gredics-identity{gap:13px}.gredics-monogram{width:58px;height:58px;flex-basis:58px;font-size:30px}.gredics-wordmark{font-size:clamp(32px,9vw,43px)}.eccss-feature{grid-template-columns:1fr}.eccss-cover-frame{min-height:220px}.eccss-cover-frame img{max-height:210px;width:auto;max-width:75%}.eccss-content{padding:27px 24px}.eccss-content h3{margin:18px 0}}

/* Estructura editorial: recerca científica i transferència educativa, sense alterar la paleta. */
.editorial-research{min-height:480px;justify-content:space-between;background:#fff3ea}
.editorial-research .editorial-symbol{display:block;font-size:66px;color:#cc623e;margin:0 0 22px}
.editorial-research h3{font-size:clamp(29px,3.25vw,42px);line-height:1.14}
.editorial-research .editorial-description{margin-top:20px;line-height:1.8;color:#5d727d}
.practice-section{padding-top:86px;scroll-margin-top:100px}
.practice-grid{display:grid;grid-template-columns:1fr 1fr;gap:17px}
.practice-card{display:flex;min-height:360px;flex-direction:column;justify-content:space-between;padding:33px 36px;border:1px solid #cee4eb;background:#e5f1f5;transition:transform .2s ease,border-color .2s ease}
.practice-card:hover{transform:translateY(-3px);border-color:#80bacd}
.practice-card .mini{color:#226387}
.practice-card h3{font:650 clamp(27px,2.45vw,36px)/1.24 'Manrope',sans-serif;letter-spacing:-.05em;max-width:600px;margin-bottom:14px}
.practice-card p{font-size:14px;color:#526a74;line-height:1.75;max-width:510px}
.practice-card strong{display:inline-block;font-size:12px;color:#1c5c7e;border-bottom:1px solid currentColor;padding-bottom:5px;margin-top:12px}
.practice-mooc .practice-symbol{font:500 60px/1 'Manrope',sans-serif;color:#d2653d;margin:12px 0}
.practice-jornades{background:#fff3ea;border-color:#f0d1bf}
.practice-event-date{display:flex;align-items:baseline;gap:18px;margin:9px 0 17px}
.practice-event-date strong{border:0;margin:0;padding:0;color:#d2653d;font:800 clamp(70px,8vw,115px)/.95 'Manrope',sans-serif;letter-spacing:-.09em}
.practice-event-date span{font:700 12px/1.5 'DM Sans',sans-serif;color:#276385;max-width:135px}
.gredics-identity{margin:23px 0 25px;width:100%;max-width:470px;min-height:108px;display:flex;align-items:center}
.gredics-official-logo{width:100%;max-width:470px;height:auto;max-height:127px;object-fit:contain;object-position:left center;display:block}
@media(max-width:1050px){.editorial-research{min-height:380px}}
@media(max-width:760px){.practice-section{padding-top:64px}.practice-grid{grid-template-columns:1fr}.practice-card{min-height:330px;padding:27px 24px}.practice-event-date strong{font-size:85px}.gredics-identity{min-height:70px}.gredics-official-logo{max-height:100px}.editorial-research{min-height:320px}.editorial-research .editorial-symbol{margin-bottom:8px}}

/* Seccions amb accés clar des del menú; manté la mateixa paleta. */
.practice-standalone{background:#eaf3f6;padding:92px 0 104px}
.practice-standalone .section-head{margin-bottom:45px}
.research-to-practice,.practice-to-videos{display:inline-flex;gap:22px;align-items:center;font-size:13px;color:#1c5d7e;font-weight:800;padding:12px 0;border-bottom:1px solid currentColor}
.research-to-practice{margin-top:35px}
.practice-to-videos{margin-top:31px}
.practice-jornades .practice-card-copy p strong{color:#1b526f}
.practice-jornades .practice-card-copy p + p{font-size:12px}
@media(max-width:760px){.practice-standalone{padding:68px 0 78px}}
.articles-section-title{font:650 clamp(26px,3.3vw,39px)/1.13 'Manrope',sans-serif;letter-spacing:-.06em;margin:13px 0 26px;color:#172d35}

.lab-source{margin-top:16px}
.lab-source small{display:block;max-width:1100px;color:#afccd9;font-size:11px;line-height:1.7}
.lab-source cite{font-style:italic}
@media(max-width:1150px){.lab-prompts{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:760px){.lab-prompts{grid-template-columns:1fr}}

/* Transició de moviment entre la portada i les línies de recerca, sense elements nous. */
html.entry-transition-ready .scroll-transition-hero{
  transform:translate3d(0,var(--hero-exit-y,0px),0) scale(var(--hero-exit-scale,1));
  opacity:var(--hero-exit-opacity,1);
  transform-origin:center top;
}
html.entry-transition-ready .topics-section>.container{
  transform:translate3d(0,var(--research-enter-y,0px),0);
  opacity:var(--research-enter-opacity,1);
}
@media(prefers-reduced-motion:reduce){
  html.entry-transition-ready .scroll-transition-hero,
  html.entry-transition-ready .topics-section>.container{
    transform:none!important;opacity:1!important;
  }
}
</style>

<script is:inline>
  // Desaparició progressiva de la portada i entrada de la recerca lligades a l'scroll.
  // Sense animació automàtica: la posició sempre reflecteix el desplaçament real.
  (() => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const hero = document.querySelector('.hero');
    const heroCopy = document.querySelector('.scroll-transition-hero');
    const research = document.querySelector('.topics-section');
    const researchContent = research?.querySelector(':scope > .container');
    if (!hero || !heroCopy || !research || !researchContent) return;

    const clamp = (x) => Math.max(0, Math.min(1, x));
    const smooth = (x) => x * x * (3 - 2 * x);
    let scheduled = false;
    let firstPaint = true;

    function renderTransition() {
      const heroBox = hero.getBoundingClientRect();
      const viewport = window.innerHeight || 1;
      const heroHeight = Math.max(1, heroBox.height);
      const exit = smooth(clamp((-heroBox.top - heroHeight * 0.14) / (heroHeight * 0.66)));

      heroCopy.style.setProperty('--hero-exit-y', Math.round(exit * -115) + 'px');
      heroCopy.style.setProperty('--hero-exit-scale', (1 - exit * .05).toFixed(3));
      heroCopy.style.setProperty('--hero-exit-opacity', (1 - exit * .68).toFixed(3));

      const researchBox = research.getBoundingClientRect();
      const enter = smooth(clamp((viewport * .9 - researchBox.top) / (viewport * .52)));
      researchContent.style.setProperty('--research-enter-y', Math.round((1 - enter) * 105) + 'px');
      researchContent.style.setProperty('--research-enter-opacity', (.28 + enter * .72).toFixed(3));

      if (firstPaint) {
        document.documentElement.classList.add('entry-transition-ready');
        firstPaint = false;
      }
      scheduled = false;
    }
    function scheduleTransition() {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(renderTransition);
    }
    renderTransition();
    window.addEventListener('scroll', scheduleTransition, { passive:true });
    window.addEventListener('resize', scheduleTransition, { passive:true });
  })();
</script>


