---
import Base from '../../layouts/Base.astro';
import {profile} from '../../data/site';
const root=import.meta.env.BASE_URL.replace(/\/$/,''); const to=(s='')=>root+'/'+s.replace(/^\//,'');
const prompts=[
 {num:'01', title:'Distingir fets, interpretacions i opinions', desc:'Com podem examinar una notícia, identificar-ne les afirmacions i buscar evidències per contrastar-les?',question:'Què sabem? Com ho sabem?'},
 {num:'02', title:'Llegir críticament les xarxes socials', desc:'Identificar fonts, emocions, silencis i punts de vista en missatges digitals i discursos públics.',question:'Qui parla, per a qui i amb quina intenció?'},
 {num:'03', title:'Dialogar sobre qüestions controvertides', desc:'Construir arguments, escoltar perspectives diferents i discutir sense renunciar als principis democràtics.',question:'Quines veus falten en aquest debat?'},
];
---
<Base title="Laboratori de Pensament Crític" active="lab" description="Laboratori de Pensament Crític: idees, preguntes, activitats i recursos per a una educació democràtica.">
  <section class="lab-hero"><div class="container hero-grid"><div><div class="eyebrow">Idees · Recursos · Activitats</div><h1 class="page-title">Laboratori de<br/><em>Pensament Crític.</em></h1><p class="lead">Un espai per posar el pensament crític en moviment: pensar conceptes, formular preguntes i imaginar com treballar-los a l’aula.</p><span class="status">Espai en desenvolupament · versió inicial</span></div><div class="question" aria-hidden="true">?</div></div></section>
  <section class="section"><div class="container">
    <div class="section-head"><div><div class="eyebrow">Una proposta de partida</div><h2 class="section-title">Pensar críticament<br/>és fer preguntes.</h2></div><p>El pensament crític no és només detectar errors. També implica interpretar el context, escoltar perspectives, argumentar i imaginar alternatives.</p></div>
    <div class="prompts">{prompts.map(p=><article class="prompt-card"><span class="mini">{p.num} / ACTIVITAT PER DESENVOLUPAR</span><h3>{p.title}</h3><p>{p.desc}</p><blockquote>{p.question}</blockquote></article>)}</div>
  </div></section>
  <section class="section section-alt"><div class="container lower-grid"><div><div class="eyebrow">Per aprofundir</div><h2 class="section-title">De la teoria<br/>a la pràctica.</h2><p>Encara estem definint quins materials originals i recursos didàctics publicarem aquí. Mentrestant, pots explorar el MOOC de la UAB sobre pensament crític en l'era digital.</p><a class="btn" href={profile.mooc} target="_blank" rel="noopener noreferrer">Veure el curs a Coursera ↗</a></div><div class="quote"><span>«</span><p>Educar per pensar críticament és, també, educar per participar.</p><small>IDEA CENTRAL DEL LABORATORI</small></div></div></section>
</Base>
<style>
.lab-hero{background:#e7f3f8;padding:90px 0;overflow:hidden}.hero-grid{display:grid;grid-template-columns:1fr .45fr;gap:35px;align-items:center}.page-title{margin:26px 0}.page-title em{color:#d7643c;font-style:normal}.question{font:800 370px/1 'Manrope',sans-serif;color:#1b6487;text-align:center;transform:rotate(15deg);text-shadow:14px 14px #f4af81}.status{display:inline-block;margin-top:23px;border:1px solid #afcddc;padding:10px 13px;font-size:11px;font-weight:800;letter-spacing:.05em;color:#205f7e}.prompts{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}.prompt-card{border:1px solid #d3e3e9;padding:32px 27px;min-height:365px;display:flex;flex-direction:column;background:#fbfdfe}.prompt-card:nth-child(2){background:#fff3eb}.prompt-card:nth-child(3){background:#eaf2ee}.prompt-card .mini{color:#b35c3e}.prompt-card h3{font:650 25px/1.26 'Manrope',sans-serif;letter-spacing:-.05em;margin:33px 0 15px}.prompt-card p{font-size:14px;line-height:1.75;color:#526c78}.prompt-card blockquote{margin:auto 0 0;padding-top:19px;font-weight:800;color:#1a5d7c;font-size:14px;border-top:1px solid #c5dbe1}.lower-grid{display:grid;grid-template-columns:1fr .8fr;gap:10%;align-items:center}.lower-grid h2{margin:21px 0}.lower-grid p{font-size:16px;color:#526f7b;line-height:1.75;max-width:630px}.lower-grid .btn{margin-top:18px}.quote{background:#1b5b7c;color:#fff;padding:48px}.quote span{font:800 85px/1 'Manrope',sans-serif;color:#f1a97a}.quote p{font:650 31px/1.32 'Manrope',sans-serif;letter-spacing:-.05em;color:#fff}.quote small{font-size:10px;letter-spacing:.13em;color:#bcdce9;font-weight:800}
@media(max-width:900px){.prompts{grid-template-columns:1fr}.prompt-card{min-height:0}.prompt-card h3{margin-top:22px}.lower-grid{grid-template-columns:1fr}}@media(max-width:760px){.hero-grid{grid-template-columns:1fr}.question{display:none}.lab-hero{padding:70px 0}}
</style>
