---
import { featuredBooks } from '../data/featuredBooks';
const { compact = false } = Astro.props;
const HeadingTag = compact ? 'h2' : 'h3';
const BookTitleTag = compact ? 'h3' : 'h4';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const toLink = (url) => /^https?:\/\//.test(url) ? url : base + '/' + url.replace(/^\/+/, '');
const coverFor = (book) => ('coverUrl' in book && book.coverUrl) ? toLink(book.coverUrl) : undefined;
---
<div class:list={['books-showcase', { 'books-compact': compact }]}>
  <div class="books-heading">
    <div class="eyebrow">Llibres i informes · Didàctica de les ciències socials</div>
    <HeadingTag>Llibres</HeadingTag>
  </div>
  <div class="books-grid">
    {featuredBooks.map((book) => (
      <article class="book-feature">
        <div class={'book-cover book-' + book.coverVariant}>
          <div class="book-cover-fallback" aria-hidden="true">
            <div class="book-publisher">{book.publisher}</div>
            <div class="cover-emblem">{book.coverVariant === 'conflict' ? '✳' : '?'}</div>
            <div class="cover-title">{book.title}</div>
            <div class="cover-bottom-rule" />
          </div>
          {'coverUrl' in book && book.coverUrl && (
            <img
              class="official-book-cover"
              src={coverFor(book)}
              alt={'Portada del llibre ' + book.title}
              loading="lazy"
              decoding="async"
              onerror="this.style.display='none'"
            />
          )}
        </div>
        <div class="book-details">
          <div class="book-kicker">{book.role} <span aria-hidden="true">·</span> {book.year}</div>
          <BookTitleTag>{book.title}</BookTitleTag>
          <p class="book-subtitle">{book.subtitle}</p>
          <p class="book-contributors">{book.contributors}</p>
          <p class="book-description">{book.description}</p>
          <div class="book-links">
            <a href={toLink(book.url)} target="_blank" rel="noopener noreferrer">{'primaryLabel' in book ? book.primaryLabel : 'Fitxa editorial'} <span aria-hidden="true">↗</span></a>
            {'secondaryUrl' in book && book.secondaryUrl && (
              <a href={toLink(book.secondaryUrl)} target="_blank" rel="noopener noreferrer">{book.secondaryLabel} <span aria-hidden="true">↗</span></a>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>
</div>
<style>
.books-showcase{padding:6px 0 36px;min-width:0}
.books-heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin:0 0 20px}
.books-heading :is(h2,h3){font:650 clamp(27px,3vw,38px)/1.1 'Manrope',sans-serif;letter-spacing:-.065em;margin:10px 0 0;color:var(--ink)}
/* Tres targetes equilibrades en una sola fila a l'escriptori. */
.books-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;align-items:stretch;min-width:0}
.book-feature{background:var(--white);border:1px solid var(--line);display:grid;grid-template-columns:96px minmax(0,1fr);align-content:start;align-items:start;gap:15px;min-width:0;padding:18px;box-shadow:0 7px 20px rgba(20,53,67,.042);transition:transform .25s ease,box-shadow .25s ease}
.book-feature:hover{transform:translateY(-3px);box-shadow:0 13px 28px rgba(20,53,67,.075)}
.book-cover{align-self:start;width:96px;aspect-ratio:2/3;position:relative;overflow:hidden;border:1px solid var(--line);box-shadow:3px 5px 12px rgba(20,51,67,.14);background:var(--cyan-pale)}
.book-cover-fallback{height:100%;padding:11px 8px 9px;display:flex;flex-direction:column;align-items:flex-start;background:linear-gradient(155deg,var(--navy) 0%,var(--cyan) 65%,var(--navy) 100%);color:var(--white)}
.book-conflict .book-cover-fallback{background:linear-gradient(157deg,var(--red) 0%,var(--red) 48%,var(--cyan) 49%,var(--navy) 100%)}
.book-publisher{font:800 8px/1.2 'Manrope',sans-serif;letter-spacing:.05em}
.cover-emblem{flex:1;display:flex;align-items:center;font:500 48px/1 'Manrope',sans-serif;color:var(--red-light)}
.cover-title{font:750 12px/1.19 'Manrope',sans-serif;letter-spacing:-.05em;overflow-wrap:break-word}
.cover-bottom-rule{height:2px;width:75%;background:var(--red-light);margin-top:10px}
.official-book-cover{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center top}
.book-infantil .official-book-cover{object-fit:contain;background:#fff}
.book-infantil .book-cover-fallback{background:linear-gradient(155deg,#056ac3,#0e9ec9)}
.book-details{display:flex;flex-direction:column;align-items:flex-start;min-width:0;min-height:100%;overflow-wrap:break-word}
.book-kicker{color:var(--red);font-weight:800;letter-spacing:.07em;font-size:9px;line-height:1.5}
.book-details :is(h3,h4){font:650 clamp(16px,1.5vw,19px)/1.24 'Manrope',sans-serif;letter-spacing:-.04em;margin:8px 0 7px;color:var(--ink)}
.book-subtitle{font-size:11px;line-height:1.45;font-weight:700;color:var(--cyan);margin:0 0 9px}
.book-contributors{font-size:10px;line-height:1.4;color:var(--muted);margin:0 0 9px}
.book-description{font-size:11px;line-height:1.55;color:var(--muted);margin:0 0 13px}
.book-links{margin-top:auto;display:flex;flex-wrap:wrap;gap:9px 12px}
.book-links a{font-size:10.5px;font-weight:800;line-height:1.45;color:var(--cyan);border-bottom:1px solid currentColor;padding-bottom:2px}
.book-links a:hover{color:var(--red)}
.book-links a:focus-visible{outline:2px solid var(--red);outline-offset:3px}
.books-compact{padding:0}
@media(max-width:1160px){
  .books-grid{gap:12px}
  .book-feature{grid-template-columns:86px minmax(0,1fr);padding:14px;gap:12px}
  .book-cover{width:86px}
  .book-details :is(h3,h4){font-size:16px}
}
@media(max-width:1020px){
  .books-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .book-feature{grid-template-columns:104px minmax(0,1fr);padding:18px;gap:17px}
  .book-cover{width:104px}
  .book-details :is(h3,h4){font-size:19px}
  .book-description{font-size:11.5px}
}
@media(max-width:690px){
  .books-grid{grid-template-columns:minmax(0,1fr);gap:12px}
  .book-feature{grid-template-columns:108px minmax(0,1fr);padding:16px;gap:16px}
  .book-cover{width:108px}
  .books-heading{margin-bottom:17px}
  .book-details :is(h3,h4){font-size:19px}
}
@media(max-width:380px){
  .book-feature{grid-template-columns:90px minmax(0,1fr);padding:12px;gap:12px}
  .book-cover{width:90px}
  .book-details :is(h3,h4){font-size:17px}
  .book-subtitle,.book-description{font-size:10.5px}
  .book-links{gap:8px}
}
@media(prefers-reduced-motion:reduce){.book-feature{transition:none}.book-feature:hover{transform:none}}
</style>
