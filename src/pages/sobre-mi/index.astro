---
import Base from '../../layouts/Base.astro';
import {profile} from '../../data/site';
const root=import.meta.env.BASE_URL.replace(/\/$/,''); const to=(s='')=>root+'/'+s.replace(/^\//,'');
const profileLinks = [
  { name:'Portal de Recerca UAB', detail:'Recerca i projectes', icon:'institution', url:profile.uab },
  { name:'Google Scholar', detail:'Publicacions i citacions', icon:'scholar', url:profile.scholar },
  { name:'ResearchGate', detail:'Xarxa de recerca', icon:'network', url:profile.researchgate },
  { name:'Bluesky', detail:'Divulgació i conversa', icon:'butterfly', url:profile.bluesky },
  { name:'ORCID', detail:'Identificador acadèmic', icon:'id', url:profile.orcid },
  { name:'GREDICS', detail:'Grup de recerca', icon:'users', url:profile.gredicsProfile },
];
---
<Base title="Sobre mi" seoTitle="Jordi Castellví Mata | Perfil acadèmic" active="about" description="Trajectòria acadèmica de Jordi Castellví Mata, professor universitari i investigador a la UAB.">
  <section class="page-hero"><div class="container"><div class="eyebrow">Sobre mi</div><h1 class="page-title">Jordi Castellví Mata.</h1><p class="lead">Professor universitari i investigador. Treballo perquè la didàctica de les ciències socials contribueixi a una educació més crítica i democràtica.</p></div></section>
  <section class="section"><div class="container about-grid">
    <article><div class="eyebrow">La meva trajectòria</div><h2 class="section-title">Investigar, ensenyar<br/>i compartir.</h2><p class="body">Soc professor de la Universitat Autònoma de Barcelona, on participo en la formació inicial del professorat i en recerques sobre ciutadania, pensament crític i educació democràtica. Soc doctor en Educació per la UAB (2019), amb menció internacional, i vaig rebre el Premi Extraordinari de Doctorat.</p><p class="body">La meva recerca s’ha centrat especialment en la literacitat crítica digital, els discursos d’odi, les qüestions socialment controvertides i la participació democràtica. M'interessa fer dialogar el coneixement acadèmic amb les preguntes reals que apareixen a les aules.</p><p class="body">He fet una estada de recerca a la University of British Columbia i participo en iniciatives editorials, projectes de recerca i activitats de formació per a docents.</p><a class="btn ghost" href={profile.uab} target="_blank" rel="noopener noreferrer">Perfil personal a la UAB ↗</a></article>
    <aside><div class="fact"><span>2019</span><strong>Doctor internacional en Educació</strong><small>Universitat Autònoma de Barcelona</small></div><div class="fact"><span>2021</span><strong>Premi Extraordinari de Doctorat</strong><small>Programa de Doctorat en Educació · UAB</small></div><div class="fact"><span>2025—</span><strong>Coordinació d'unitat departamental</strong><small>Didàctica de les Ciències Socials · UAB</small></div><div class="fact"><span>GREDICS</span><strong>Investigació en educació i ciutadania</strong><small>Grup de Recerca en Didàctica de les Ciències Socials</small></div></aside>
  </div></section>
  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <div><div class="eyebrow">Perfils acadèmics i xarxes</div><h2 class="section-title">Seguim en contacte.</h2></div>
      </div>
      <div class="links">
        {profileLinks.map(l => (
          <a class="profile-entry" href={l.url} target="_blank" rel="noopener noreferrer" aria-label={'Obre el meu perfil de ' + l.name}>
            <span class="profile-entry-main">
              <span class="profile-entry-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  {l.icon === 'institution' && <><path d="M3 9L12 4l9 5M5 9h14M5 20h14M7 10v9m5-9v9m5-9v9"/></>}
                  {l.icon === 'scholar' && <><path d="m2 9 10-5 10 5-10 5L2 9Zm4 2.5V17c3.5 3 8.5 3 12 0v-5.5M22 9v8"/></>}
                  {l.icon === 'network' && <><circle cx="5" cy="12" r="2.5"/><circle cx="19" cy="5" r="2.5"/><circle cx="19" cy="19" r="2.5"/><path d="m7.5 10.8 9-4.7m-9 7.1 9 4.7"/></>}
                  {l.icon === 'butterfly' && <><path d="M12 12c-1.6-3-5.4-7-8-7-2 0-2 2-2 3 0 3.5 2.5 5 7 5-4 0-5 2-3.9 4 1.9 3.7 5.4.8 6.9-2.3 1.5 3.1 5 6 6.9 2.3C20 15 19 13 15 13c4.5 0 7-1.5 7-5 0-1 0-3-2-3-2.6 0-6.4 4-8 7Z"/></>}
                  {l.icon === 'id' && <><rect x="3" y="4" width="18" height="16" rx="3"/><circle cx="9" cy="10" r="2"/><path d="M5.5 16c.6-2 1.8-3 3.5-3s2.9 1 3.5 3M15 9h4m-4 4h4m-4 4h3"/></>}
                  {l.icon === 'users' && <><circle cx="9" cy="8" r="3"/><path d="M3 20v-2c0-3 2-5 6-5s6 2 6 5v2H3ZM17 6a3 3 0 0 1 0 6m-1 2c3 .2 5 2 5 5v1h-4"/></>}
                </svg>
              </span>
              <span class="profile-entry-text"><strong>{l.name}</strong><small>{l.detail}</small></span>
            </span>
            <span class="profile-entry-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
        <a class="profile-entry profile-email-link" href={'mailto:'+profile.email}>
          <span class="profile-entry-main">
            <span class="profile-entry-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 7 9-7"/></svg>
            </span>
            <span class="profile-entry-text"><strong>Escriu-me</strong><small>{profile.email}</small></span>
          </span>
          <span class="profile-entry-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</Base>
<style>
.page-hero h1 span{color:var(--red)}.about-grid{display:grid;grid-template-columns:1fr .7fr;gap:11%;align-items:start}.about-grid h2{margin:20px 0 30px}.body{font-size:17px;line-height:1.82;color:var(--muted);margin-bottom:24px}.about-grid .btn{margin-top:14px}aside{background:var(--cyan-pale);padding:30px 35px}.fact{padding:22px 0;border-bottom:1px solid var(--line);display:flex;flex-direction:column;gap:10px}.fact:last-child{border-bottom:0}.fact span{font-size:12px;color:var(--red);font-weight:800;letter-spacing:.08em}.fact strong{font:650 22px/1.35 'Manrope',sans-serif;letter-spacing:-.05em}.fact small{font-size:12px;color:var(--muted)}.links{border-top:1px solid var(--line);display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:24px}
.links .profile-entry{display:flex;align-items:center;justify-content:space-between;gap:16px;min-width:0;min-height:92px;padding:17px 10px 17px 0;border-bottom:1px solid var(--line);color:var(--cyan);text-decoration:none;transition:color .2s ease}
.profile-entry-main{display:flex;align-items:center;gap:15px;min-width:0}
.profile-entry-icon{display:grid;place-items:center;width:43px;height:43px;flex:0 0 43px;border-radius:10px;background:var(--cyan-pale);color:var(--cyan)}
.profile-entry-icon svg{width:23px;height:23px;display:block}
.profile-entry-text{display:flex;flex-direction:column;gap:4px;min-width:0}
.profile-entry-text strong{font:750 15px/1.35 'Manrope',sans-serif;letter-spacing:-.02em}
.profile-entry-text small{font-size:12px;font-weight:500;color:var(--muted);line-height:1.4;overflow-wrap:anywhere}
.links .profile-entry-arrow{font-size:16px;color:var(--red);flex-shrink:0;transition:transform .2s ease}
.links .profile-entry:hover .profile-entry-arrow{transform:translate(3px,-3px)}
.links .profile-entry:focus-visible{outline:2px solid var(--red);outline-offset:2px}
@media(max-width:760px){.about-grid{grid-template-columns:1fr}.links{grid-template-columns:1fr}.links .profile-entry{min-height:82px;padding:15px 0}}
</style>
