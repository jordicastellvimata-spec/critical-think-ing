---
import Base from '../layouts/Base.astro';
import { profile, researchProjects, otherInitiatives } from '../data/site';
const root=import.meta.env.BASE_URL.replace(/\/$/,''); const to=(s='')=>root+'/'+s.replace(/^\//,'');
---
<Base title="Projectes i iniciatives" active="projects" description="Projectes de recerca, coordinació editorial i formació oberta de Jordi Castellví Mata.">
  <section class="page-hero"><div class="container"><div class="eyebrow">Recerca · Edició · Transferència</div><h1 class="page-title">Projectes<span> i iniciatives.</span></h1><p class="lead">La meva activitat va més enllà dels articles científics. Aquí conviuen els projectes de recerca, les col·laboracions editorials i les propostes de formació i divulgació.</p></div></section>
  <section class="section research-section"><div class="container">
    <div class="section-head"><div><div class="eyebrow">Investigació</div><h2 class="section-title">Projectes de recerca.</h2></div><p>Projectes finançats en què he participat com a investigador o col·laborador.</p></div>
    <div class="research-list">{researchProjects.map(p=><article class="research-item"><div class="research-year"><strong>{p.period}</strong><span>{p.status}</span></div><div><span class="tag">{p.code}</span><h3>{p.title}</h3><p>{p.description}</p><small>{p.role}</small></div></article>)}</div>
    <div class="group-box"><div><span class="mini">Grup de recerca</span><h3>GREDICS</h3><p>Formo part del Grup de Recerca en Didàctica de les Ciències Socials de la Universitat Autònoma de Barcelona.</p></div><a class="btn" href={profile.gredics} target="_blank" rel="noopener noreferrer">Visitar GREDICS ↗</a></div>
  </div></section>
  <section class="section section-alt"><div class="container">
    <div class="section-head"><div><div class="eyebrow">Més enllà dels projectes competitius</div><h2 class="section-title">Altres iniciatives.</h2></div><p>Edició científica, materials de formació i transferència de coneixement.</p></div>
    <div class="initiative-list">{otherInitiatives.map(item=><article class="initiative-card"><span class="mini">{item.eyebrow}</span><h3>{item.title}</h3><p class="subtitle">{item.subtitle}</p><p>{item.description}</p><a class="text-link" href={item.url} target="_blank" rel="noopener noreferrer">{item.linkText} ↗</a></article>)}</div>
  </div></section>
</Base>
<style>
.page-hero h1 span{color:#d95f37}.research-list{border-top:1px solid #cbdde5}.research-item{display:grid;grid-template-columns:195px 1fr;gap:35px;padding:38px 0;border-bottom:1px solid #cbdde5}.research-year{display:flex;flex-direction:column;gap:14px}.research-year strong{font:750 25px/1.3 'Manrope',sans-serif;color:#c35b36;letter-spacing:-.04em}.research-year span{font-size:10px;font-weight:800;letter-spacing:.12em;color:#467086}.research-item h3{font:650 29px/1.2 'Manrope',sans-serif;letter-spacing:-.055em;max-width:810px;margin:10px 0 14px}.research-item p{color:#536b77;line-height:1.75;font-size:15px;max-width:730px}.research-item small{font-size:12px;font-weight:800;color:#27607c}.group-box{margin-top:42px;background:#1b5d7c;color:#fff;padding:34px;display:flex;align-items:center;justify-content:space-between;gap:25px}.group-box h3{font:700 35px 'Manrope',sans-serif;letter-spacing:-.07em;margin:9px 0}.group-box p{color:#d7e9ef;line-height:1.6;font-size:14px;margin:0;max-width:570px}.group-box .mini{color:#d4eaf4}.group-box .btn{background:#f7b58b;color:#1b3440}.initiative-list{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}.initiative-card{padding:33px 28px;background:#fff;min-height:390px;border:1px solid #d0e1e7;display:flex;flex-direction:column}.initiative-card:nth-child(2){background:#fff4ec;border-color:#eed6c8}.initiative-card .mini{color:#b65a3c}.initiative-card h3{font:650 27px/1.27 'Manrope',sans-serif;letter-spacing:-.05em;margin:20px 0 8px}.initiative-card p{font-size:14px;line-height:1.7;color:#4f6977;margin:8px 0}.initiative-card p.subtitle{font-size:12px;font-weight:800;color:#215c7a}.initiative-card .text-link{margin-top:auto;padding-top:25px}
@media(max-width:900px){.initiative-list{grid-template-columns:1fr}.initiative-card{min-height:0}}@media(max-width:760px){.research-item{grid-template-columns:1fr;gap:15px}.group-box{flex-direction:column;align-items:flex-start}}
</style>
