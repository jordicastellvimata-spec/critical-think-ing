---
import Base from '../../layouts/Base.astro';
import {profile} from '../../data/site';
import { criticalLiteracyDimensions, criticalLiteracyCitation } from '../../data/criticalLiteracyDimensions';
const root=import.meta.env.BASE_URL.replace(/\/$/,''); const to=(s='')=>root+'/'+s.replace(/^\//,'');

---
<Base title="Laboratori de Pensament Crític" active="lab" description="Laboratori de Pensament Crític: idees, preguntes, activitats i recursos per a una educació democràtica.">
  <section class="lab-hero"><div class="container hero-grid"><div><div class="eyebrow">Idees · Recursos · Activitats</div><h1 class="page-title">Laboratori de<br/><em>Pensament Crític.</em></h1><p class="lead">Un espai per posar el pensament crític en moviment: pensar conceptes, formular preguntes i imaginar com treballar-los a l’aula.</p></div><div class="question" aria-hidden="true">?</div></div></section>
  <section class="section"><div class="container">
    <div class="section-head"><div><div class="eyebrow">Les quatre dimensions de la literacitat crítica</div><h2 class="section-title">Qüestionar, interpretar<br/>i transformar.</h2></div><p>Mirar la realitat amb altres ulls, escoltar perspectives diverses, examinar les relacions de poder i actuar per la justícia social.</p></div>
    <div class="prompts" aria-label="Quatre dimensions de la literacitat crítica">{criticalLiteracyDimensions.map(d=><article class="prompt-card"><h3>{d.title}</h3><p>{d.description}</p></article>)}</div>
    <p class="citation"><small>Font: {criticalLiteracyCitation.authors} ({criticalLiteracyCitation.year}). «{criticalLiteracyCitation.title}». <cite>{criticalLiteracyCitation.journal}</cite>, {criticalLiteracyCitation.volume}, {criticalLiteracyCitation.pages}.</small></p>
  </div></section>
  <section class="section section-alt"><div class="container lower-grid"><div><div class="eyebrow">Per aprofundir</div><h2 class="section-title">De la teoria<br/>a la pràctica.</h2><p>El MOOC «La formación del pensamiento crítico en la era digital» aprofundeix en la lectura crítica de la informació, la ciutadania i l'educació democràtica.</p><a class="btn" href={profile.mooc} target="_blank" rel="noopener noreferrer">Veure el curs a Coursera ↗</a></div><div class="quote"><span>«</span><p>Educar per pensar críticament és, també, educar per participar.</p><small>IDEA CENTRAL DEL LABORATORI</small></div></div></section>
</Base>
<style>
.lab-hero{background:var(--cyan-pale);padding:90px 0;overflow:hidden}.hero-grid{display:grid;grid-template-columns:1fr .45fr;gap:35px;align-items:center}.page-title{margin:26px 0}.page-title em{color:var(--red);font-style:normal}.question{font:800 370px/1 'Manrope',sans-serif;color:var(--cyan);text-align:center;transform:rotate(15deg);text-shadow:14px 14px var(--red-light)}.status{display:inline-block;margin-top:23px;border:1px solid var(--line-strong);padding:10px 13px;font-size:11px;font-weight:800;letter-spacing:.05em;color:var(--cyan)}.prompts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:17px}.prompt-card{border:1px solid var(--line);padding:32px 27px;min-height:365px;display:flex;flex-direction:column;background:var(--offwhite)}.prompt-card:nth-child(2){background:var(--rose)}.prompt-card:nth-child(3){background:var(--rose)}.prompt-card h3{font:650 25px/1.26 'Manrope',sans-serif;letter-spacing:-.05em;margin:5px 0 15px}.prompt-card p{font-size:14px;line-height:1.75;color:var(--muted)}.prompt-card blockquote{margin:auto 0 0;padding-top:19px;font-weight:800;color:var(--cyan);font-size:14px;border-top:1px solid var(--line)}.lower-grid{display:grid;grid-template-columns:1fr .8fr;gap:10%;align-items:center}.lower-grid h2{margin:21px 0}.lower-grid p{font-size:16px;color:var(--muted);line-height:1.75;max-width:630px}.lower-grid .btn{margin-top:18px}.quote{background:var(--cyan);color:var(--white);padding:48px}.quote span{font:800 85px/1 'Manrope',sans-serif;color:var(--red-light)}.quote p{font:650 31px/1.32 'Manrope',sans-serif;letter-spacing:-.05em;color:var(--white)}.quote small{font-size:10px;letter-spacing:.13em;color:var(--on-dark);font-weight:800}
@media(max-width:900px){.prompts{grid-template-columns:1fr}.prompt-card{min-height:0}.prompt-card h3{margin-top:5px}.lower-grid{grid-template-columns:1fr}}@media(max-width:760px){.hero-grid{grid-template-columns:1fr}.question{display:none}.lab-hero{padding:70px 0}}

.prompt-card{min-height:290px}
.prompt-card:nth-child(4){background:var(--cyan-pale)}
.prompt-card p{margin-top:0}
.citation{font-size:11px;color:var(--muted);line-height:1.75;margin:20px 0 0}
.citation cite{font-style:italic}
</style>
