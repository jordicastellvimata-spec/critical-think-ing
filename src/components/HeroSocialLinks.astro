---
import { profile } from '../data/site';
const links = [
  {label:'Google Scholar',short:'Scholar',url:profile.scholar,path:'m2 8 10-5 10 5-10 5L2 8Zm4.5 3.6V16c3.5 2.2 7.5 2.2 11 0v-4.4M21 8v8',icon:'svg'},
  {label:'ResearchGate',short:'ResearchGate',url:profile.researchgate,letter:'RG'},
  {label:'ORCID',short:'ORCID',url:profile.orcid,letter:'iD'},
  {label:'Bluesky',short:'Bluesky',url:profile.bluesky,path:'M12 11.5C9.8 7.6 5.6 4 3.8 4.6 2.3 5 2.3 9.5 3.5 11.2c1.1 1.6 3.5 1.9 6.1 1.9-2.4.5-4.4 2.2-3.9 4.1.5 1.9 2.8 2.2 4.5.8 1.4-1.2 2.3-3.2 3-5.1.7 1.9 1.6 3.9 3 5.1 1.7 1.4 4 1.1 4.5-.8.5-1.9-1.5-3.6-3.9-4.1 2.6 0 5-.3 6.1-1.9 1.2-1.7 1.2-6.2-.3-6.6-1.8-.6-6 3-8.2 6.9Z',fill:true},
  {label:'Perfil UAB',short:'UAB',url:profile.uab,path:'m3 9 9-5.3L21 9H3Zm2.5 2v7M10 11v7m4-7v7m4.5-7v7M3 20h18',icon:'svg'},
  {label:'GREDICS',short:'GREDICS',url:profile.gredicsProfile,path:'m12 3 7.8 4.5v9L12 21l-7.8-4.5v-9L12 3ZM4.2 7.5l15.6 9M19.8 7.5l-15.6 9M12 3v18',icon:'svg'}
];
---
<nav class="hero-socials" aria-label="Perfils acadèmics i xarxes socials">
  {links.map(link=>(
    <a class="social-link" href={link.url} target="_blank" rel="noopener noreferrer" aria-label={'Obrir '+link.label} title={link.label}>
      <span class="social-icon" aria-hidden="true">
        {link.letter
          ? <span class="social-monogram">{link.letter}</span>
          : <svg viewBox="0 0 24 24" fill={link.fill?'currentColor':'none'} stroke={link.fill?'none':'currentColor'} stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"><path d={link.path}/></svg>
        }
      </span>
      <span class="social-label">{link.short}</span>
    </a>
  ))}
</nav>
<style>
.hero-socials{display:flex;justify-content:center;align-items:flex-start;flex-wrap:wrap;gap:13px;max-width:850px;margin:24px auto 0;padding:0}
.social-link{display:flex;flex-direction:column;align-items:center;gap:8px;min-width:81px;color:var(--cyan);text-decoration:none}
.social-icon{width:46px;height:46px;display:grid;place-items:center;border:1px solid var(--line-strong);background:var(--white);border-radius:50%;box-shadow:0 4px 12px rgba(16,55,70,.035);transition:color .2s,background .2s,border-color .2s,transform .2s}
.social-icon svg{display:block;width:23px;height:23px}
.social-monogram{font:800 15px/1 'Manrope',sans-serif;letter-spacing:-.06em}
.social-label{color:var(--muted);font:700 10px/1.3 'DM Sans',sans-serif}
.social-link:hover .social-icon,.social-link:focus-visible .social-icon{color:var(--white);background:var(--cyan);border-color:var(--cyan);transform:translateY(-3px)}
.social-link:hover .social-label,.social-link:focus-visible .social-label{color:var(--red)}
.social-link:focus-visible{outline:2px solid var(--red);outline-offset:5px;border-radius:4px}
@media(max-width:760px){.hero-socials{margin-top:20px;gap:8px;flex-wrap:nowrap;max-width:100%}.social-link{min-width:0;flex:0 0 39px;gap:0}.social-icon{width:39px;height:39px}.social-icon svg{width:20px;height:20px}.social-label{display:none}}
@media(max-width:370px){.hero-socials{gap:7px}.social-link{flex-basis:37px}.social-icon{width:37px;height:37px}}
@media(prefers-reduced-motion:reduce){.social-icon{transition:none}.social-link:hover .social-icon{transform:none}}
</style>