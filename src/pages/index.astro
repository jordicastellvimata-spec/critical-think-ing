<script is:inline>
  // Animació reversible controlada per scroll, amb un tram de portada fix (sticky).
  (() => {
    const scene = document.querySelector('.hero-scroll-scene');
    const hero = scene?.querySelector('.hero');
    const research = document.querySelector('.topics-section');
    const header = document.querySelector('.site-header');
    const actions = hero?.querySelector('.hero-actions');
    const socials = hero?.querySelector('.hero-socials');
    const heroFoot = hero?.querySelector('.hero-foot');
    if (!scene || !hero || !research || !header) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const desktopHeight = window.matchMedia('(min-height: 700px)');
    const mobileHeight = window.matchMedia('(min-height: 600px)');
    const mobile = window.matchMedia('(max-width: 760px)');
    const canAnimate = () => !reduced.matches &&
      (mobile.matches ? mobileHeight.matches : desktopHeight.matches);

    const root = document.documentElement;
    const clamp = (value) => Math.max(0, Math.min(1, value));
    const ease = (value) => value * value * (3 - 2 * value);
    const windowOf = (p, a, b) => ease(clamp((p - a) / (b - a)));
    let scheduled = false;
    const cards = Array.from(research.querySelectorAll('.topic-card'));
    let cardObserver;
    if ('IntersectionObserver' in window) {
      cardObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          cardObserver.unobserve(entry.target);
        });
      }, {threshold:.08,rootMargin:'0px 0px -25px 0px'});
      cards.forEach(card => cardObserver.observe(card));
    }

    function render() {
      if (!canAnimate()) { scheduled = false; return; }
      const nav = header.getBoundingClientRect().height;
      scene.style.setProperty('--hero-nav-height', nav + 'px');

      const sceneBox = scene.getBoundingClientRect();
      // Mesurem l'alçada fixa (svh) real de la portada: les barres del navegador mòbil no creen salts.
      const stickyHeight = Math.max(1, hero.getBoundingClientRect().height);
      const distance = Math.max(1, sceneBox.height - stickyHeight);
      const progress = clamp((nav - sceneBox.top) / distance);

      // Primer desapareix el suport. El títol queda fix, creix i s'esvaeix.
      const zoomProgress = windowOf(progress, .09, .83);
      const supportProgress = windowOf(progress, .07, .44);
      const titleExit = windowOf(progress, .43, .92);
      hero.style.setProperty('--headline-zoom', (1 + zoomProgress * (mobile.matches ? .35 : .55)).toFixed(4));
      hero.style.setProperty('--headline-lift', Math.round(zoomProgress * -36) + 'px');
      hero.style.setProperty('--headline-opacity', (1 - titleExit).toFixed(4));
      hero.style.setProperty('--support-opacity', (1 - supportProgress).toFixed(4));
      hero.style.setProperty('--support-shift', Math.round(-45 * supportProgress) + 'px');
      hero.style.setProperty('--foot-shift', Math.round(-28 * supportProgress) + 'px');
      hero.style.setProperty('--hero-wash', (windowOf(progress, .64, 1) * .95).toFixed(4));

      // La segona secció entra des de sota, sense superposicions afegides.
      const researchBox = research.getBoundingClientRect();
      const viewHeight = Math.max(1, window.innerHeight);
      const headReveal = ease(clamp((viewHeight * .98 - researchBox.top) / (viewHeight * .67)));
      const cardsReveal = ease(clamp((viewHeight * .88 - researchBox.top) / (viewHeight * .77)));
      research.style.setProperty('--research-head-y', Math.round((1 - headReveal) * 100) + 'px');
      research.style.setProperty('--research-head-opacity', headReveal.toFixed(4));
      research.style.setProperty('--research-cards-y', Math.round((1 - cardsReveal) * 145) + 'px');
      research.style.setProperty('--research-cards-opacity', cardsReveal.toFixed(4));

      // Els enllaços invisibles no han de rebre el focus.
      const inactive = supportProgress > .96;
      if (actions) actions.inert = inactive;
      if (socials) socials.inert = inactive;
      if (heroFoot) heroFoot.inert = inactive;
      scheduled = false;
    }

    function schedule() {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(render);
    }

    function syncMotion() {
      const enabled = canAnimate();
      root.classList.toggle('apple-scroll-ready', enabled);
      // Evitem ocultar les targetes si no hi ha observador o s'ha activat el moviment reduït.
      research.classList.toggle('mobile-cards-ready',
        enabled && mobile.matches && !!cardObserver);
      if (!enabled) {
        if (actions) actions.inert = false;
        if (socials) socials.inert = false;
        if (heroFoot) heroFoot.inert = false;
      } else schedule();
    }

    scene.style.setProperty('--hero-nav-height', header.getBoundingClientRect().height + 'px');
    syncMotion();
    window.addEventListener('scroll', schedule, {passive:true});
    window.addEventListener('resize', () => { syncMotion(); schedule(); }, {passive:true});
    window.addEventListener('load', schedule, {once:true});
    [reduced,desktopHeight,mobileHeight,mobile].forEach(
      mq => mq.addEventListener?.('change', syncMotion)
    );
  })();
</script>


