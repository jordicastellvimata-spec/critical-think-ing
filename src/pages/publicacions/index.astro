---
import Base from '../../layouts/Base.astro';
import PublicationExplorer from '../../components/PublicationExplorer.astro';
import FeaturedBooks from '../../components/FeaturedBooks.astro';
import { profile } from '../../data/site';
const root=import.meta.env.BASE_URL.replace(/\/$/,''); const to=(s='')=>root+'/'+s.replace(/^\//,'');
---
<Base title="Publicacions" seoTitle="Publicacions sobre pensament crític i educació | Jordi Castellví Mata" active="pubs" description="Articles científics publicats per Jordi Castellví Mata en revistes acadèmiques sobre pensament crític, educació i ciutadania democràtica.">
  <section class="page-hero"><div class="container"><div class="eyebrow">Producció científica</div><h1 class="page-title">Publicacions<span>.</span></h1><p class="lead">Pensament crític, ciutadania democràtica, alfabetització digital, discursos d’odi i educació per al futur.</p></div></section>
  <section class="section"><div class="container">
    <div class="intro-row"><span class="mini">Articles de recerca · 2019—2026</span><div class="intro-actions"><a class="cv-download" href={to("documents/cv-academic-jordi-castellvi-mata-2026.pdf")} download>Descarrega el CV resumit (PDF) ↓</a><a class="text-link" href={profile.uab} target="_blank" rel="noopener noreferrer">Veure el catàleg complet a la UAB ↗</a></div></div>
    <FeaturedBooks compact={true} />
    <h2 class="journal-article-title">Articles de recerca</h2>
    <PublicationExplorer />
    <div class="note-box"><p><a href={profile.uab} target="_blank" rel="noopener noreferrer">Portal de Recerca UAB ↗</a> · <a href={profile.orcid} target="_blank" rel="noopener noreferrer">ORCID ↗</a> · <a href={profile.scholar} target="_blank" rel="noopener noreferrer">Google Scholar ↗</a></p></div>
  </div></section>
</Base>
<style>
.intro-actions{display:flex;align-items:center;gap:14px 22px;flex-wrap:wrap}.cv-download{color:var(--red);font-size:12px;font-weight:800;text-decoration:none}.cv-download:hover{text-decoration:underline}.page-hero h1 span{color:var(--red)}.intro-row{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:32px}.note-box{background:var(--cyan-pale);padding:28px 35px;margin-top:45px}.note-box p{font-size:14px;line-height:1.8;color:var(--muted);margin:0}.note-box a{font-weight:800;color:var(--cyan)}
@media(max-width:760px){.intro-row{display:flex;align-items:flex-start;flex-direction:column}}
.journal-article-title{font:650 var(--type-section)/1.15 'Manrope',sans-serif;letter-spacing:-.06em;margin:58px 0 26px}
</style>
