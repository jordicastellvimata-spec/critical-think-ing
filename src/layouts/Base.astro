---
import { profile } from '../data/site';
import AsteriskIcon from '../components/AsteriskIcon.astro';
const {title='Jordi Castellví Mata', seoTitle = `${title} | critical-think.ing`, description='Pensament crític, educació democràtica i didàctica de les ciències socials.', active=''} = Astro.props;

const identityId = 'https://critical-think.ing/#person';
const academicSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://critical-think.ing/#website',
      name: 'critical-think.ing',
      url: 'https://critical-think.ing/',
      inLanguage: ['ca', 'es', 'en', 'fr'],
      about: { '@id': identityId }
    },
    {
      '@type': 'Person',
      '@id': identityId,
      name: profile.name,
      url: 'https://critical-think.ing/',
      image: 'https://critical-think.ing/images/jordi-castellvi-retrat.webp',
      description: profile.role,
      jobTitle: 'Professor universitari i investigador en didàctica de les ciències socials',
      worksFor: { '@type': 'CollegeOrUniversity', name: 'Universitat Autònoma de Barcelona', url: 'https://www.uab.cat/' },
      knowsAbout: ['Didàctica de les ciències socials','Pensament crític','Educació democràtica','Discursos d’odi i contrarelats','Ciutadania crítica'],
      sameAs: [profile.uab, profile.orcid, profile.scholar, profile.researchgate, profile.gredicsProfile, profile.bluesky]
    }
  ]
};
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (p='') => root + '/' + p.replace(/^\//,'');
// Navegació principal en una sola pàgina; les subpàgines continuen accessibles com a arxiu.
// Ordre del menú = ordre vertical de les seccions de la portada.
const nav = [
  { label:'Línies de recerca', path:'#recerca', key:'research' },
  { label:'Publicacions', path:'#publicacions', key:'pubs' },
  { label:'Projectes', path:'#projectes', key:'projects' },
  { label:'Pràctica', path:'#transferencia', key:'practice' },
  { label:'Docència', path:'#docencia', key:'teaching' },
  { label:'GREDICS', path:'#xarxes-academiques', key:'group' },
  { label:'Laboratori', path:'#laboratori', key:'lab' },
  { label:'Sobre mi', path:'#sobre-mi', key:'about' },
];
---
<!doctype html>
<html lang="ca">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#FCFBF8" />
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="critical-think.ing" />
  <meta property="og:title" content={seoTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://critical-think.ing/images/jordi-castellvi-retrat.webp" />
  <meta property="og:image:alt" content="Retrat de Jordi Castellví Mata" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={seoTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://critical-think.ing/images/jordi-castellvi-retrat.webp" />
  <title>{seoTitle}</title>
  <script type="application/ld+json" set:html={JSON.stringify(academicSchema)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="scroll-progress" aria-hidden="true"></div>
  <div class="site-header">
    <header class="container header-content">
      <a class="wordmark" href={url('')} aria-label="Inici de critical-think.ing"><span class="mark"><AsteriskIcon /></span><span>critical<span class="wordmark-accent">-</span>think<span class="wordmark-accent">.</span>ing</span></a>
      <nav class="desktop-nav" aria-label="Navegació principal">{nav.map(item=><a href={url(item.path)} aria-current={active===item.key?'page':undefined}>{item.label}</a>)}</nav>
      <a class="desktop-contact" href={url('#contacte')}>Contacte <span aria-hidden="true">↗</span></a>
      <div class="language-picker">
        <details aria-label="Selector d'idioma">
          <summary aria-label="Canviar l’idioma" aria-haspopup="true"><span class="lang-current-text" data-lang-current="CA">CA</span><span class="lang-chevron" aria-hidden="true"></span></summary>
          <nav aria-label="Idiomes disponibles" class="language-options">
            <a href="/" data-lang-link="ca" lang="ca" hreflang="ca">Català</a>
            <a href="/es/" data-lang-link="es" lang="es" hreflang="es">Español</a>
            <a href="/en/" data-lang-link="en" lang="en" hreflang="en">English</a>
            <a href="/fr/" data-lang-link="fr" lang="fr" hreflang="fr">Français</a>
          </nav>
        </details>
      </div>
      <details class="mobile-nav">
        <summary aria-label="Obrir el menú">Menú <span aria-hidden="true">☰</span></summary>
        <nav aria-label="Navegació mòbil">{nav.map(item=><a href={url(item.path)}>{item.label}</a>)}<a href={url('#contacte')}>Contacte ↗</a></nav>
      </details>
    </header>
  </div>
  <main id="main"><slot /></main>
  <script is:inline>
    document.querySelectorAll('[data-lang-link]').forEach(link => {
      link.addEventListener('click', () => {
        if (window.location.hash) link.href = link.href.split('#')[0] + window.location.hash;
      });
    });
  </script>
  <footer class="site-footer">
    <div class="container footer-columns">
      <div>
        <a class="footer-mark" href={url('')}>critical-think.ing</a>
        <p>Jordi Castellví Mata<br/>Recerca, educació i pensament crític</p>
        <nav class="footer-site-links" aria-label="Seccions de la web">
          <a href={url('publicacions/')}>Publicacions</a>
          <a href={url('projectes/')}>Projectes</a>
          <a href={url('laboratori/')}>Laboratori</a>
          <a href={url('sobre-mi/')}>Sobre mi</a>
        </nav>
      </div>
      <div class="footer-links" aria-label="Perfils acadèmics i xarxes"><a href={profile.uab} target="_blank" rel="noopener noreferrer">Perfil UAB ↗</a><a href={profile.scholar} target="_blank" rel="noopener noreferrer">Google Scholar ↗</a><a href={profile.researchgate} target="_blank" rel="noopener noreferrer">ResearchGate ↗</a><a href={profile.bluesky} target="_blank" rel="noopener noreferrer">Bluesky ↗</a><a href={profile.orcid} target="_blank" rel="noopener noreferrer">ORCID ↗</a><a href={profile.gredics} target="_blank" rel="noopener noreferrer">GREDICS ↗</a></div>
      <div class="footer-email"><span>CONTACTE ACADÈMIC</span><a href={'mailto:'+profile.email}>{profile.email} ↗</a><small>© {new Date().getFullYear()} Jordi Castellví Mata</small></div>
    </div>
  </footer>
  <script is:inline>
    // Animacions progressives i discretes, accessibles i sense dependències externes.
    (function () {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (reduced.matches || !('IntersectionObserver' in window)) return;
      const selectors = '.section-head, .topic-card, .book-feature, .paper, .video-card, .project-feature, .initiative, .network-feature, .research-mini, .lab-grid, .lab-prompt, .about-grid, .contact-inner, .hero-copy:not(.scroll-cinematic-hero), .hero-visual';
      const elements = Array.from(document.querySelectorAll(selectors)).filter(el => !el.closest('.topics-section'));
      elements.forEach((el) => el.setAttribute('data-reveal', ''));
      // Habilitem les transicions després de preparar les seccions, per evitar salts inicials.
      document.documentElement.classList.add('motion-ready');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -24px 0px' });
      elements.forEach((el) => observer.observe(el));
      const bar = document.querySelector('.scroll-progress');
      let ticking = false;
      function updateProgress() {
        const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        if (bar) bar.style.transform = 'scaleX(' + Math.max(0, Math.min(1, window.scrollY / max)) + ')';
        ticking = false;
      }
      window.addEventListener('scroll', () => {
        if (!ticking) { requestAnimationFrame(updateProgress); ticking = true; }
      }, { passive: true });
      updateProgress();
    })();
  </script>
</body>
</html>
<style is:global>
:root{--paper:#FCFBF8;--white:#FFFFFF;--offwhite:#F7FBFC;--ink:#172A33;--navy:#103746;--cyan:#006C85;--cyan-dark:#00536B;--cyan-bright:#00A3BC;--red:#C53243;--red-dark:#AC2537;--red-light:#FFB7BF;--red-light-hover:#FFD1D6;--rose:#FDECEF;--rose-line:#F2D5DB;--cyan-pale:#E8F7FA;--line:#D2E2E6;--line-strong:#A4C9D2;--on-dark:#D5EDF3;--muted:#536873;--cyan-line-alpha:rgba(0,163,188,.35);--navy-alpha:rgba(16,55,70,.9);font-family:'DM Sans',Arial,sans-serif;color:var(--ink);background:var(--paper);font-synthesis:none;font-weight:400}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;min-width:320px}
a{text-decoration:none;color:inherit}
button{font:inherit}
::selection{background:var(--red-light);color:var(--ink)}
.container{width:min(100% - 9vw,1360px);margin-inline:auto}
.site-header{background:var(--paper);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:50}
.header-content{min-height:92px;display:flex;align-items:center;gap:32px}
.wordmark{display:flex;align-items:center;gap:11px;font:800 20px/1 'Manrope',Arial,sans-serif;letter-spacing:-.075em;white-space:nowrap}
.mark{width:35px;height:35px;border-radius:50%;background:var(--cyan);color:var(--white);display:grid;place-items:center;font:600 24px/1 'DM Sans',sans-serif}
.wordmark-accent{color:var(--red)}
.desktop-nav{display:flex;align-items:center;gap:13px;margin-left:auto}
.desktop-nav a{font-size:12px;font-weight:700;padding:10px 0;border-bottom:2px solid transparent;white-space:nowrap}
.desktop-nav a:hover,.desktop-nav a[aria-current=page]{border-color:var(--red);color:var(--cyan)}
.desktop-contact{font-size:12px;font-weight:800;white-space:nowrap;color:var(--white);background:var(--cyan);padding:13px 17px}
.desktop-contact:hover,.btn:hover{background:var(--cyan-dark)}
.desktop-contact span{margin-left:10px}
.language-picker{position:relative;flex-shrink:0;z-index:65}
.language-picker details{position:relative}
.language-picker summary{min-width:52px;min-height:39px;display:flex;align-items:center;justify-content:center;gap:8px;list-style:none;cursor:pointer;padding:8px 10px;border:1px solid var(--line-strong);border-radius:2px;background:var(--paper);color:var(--cyan);font-size:12px;font-weight:800;letter-spacing:.05em}
.language-picker summary::-webkit-details-marker{display:none}
.language-picker summary:focus-visible{outline:2px solid var(--red);outline-offset:3px}
.language-picker details[open] summary,.language-picker summary:hover{background:var(--cyan-pale)}
.lang-chevron{display:inline-block;width:7px;height:7px;border-right:1.5px solid currentColor;border-bottom:1.5px solid currentColor;transform:rotate(45deg) translateY(-2px)}
.language-options{position:absolute;top:calc(100% + 7px);right:0;min-width:160px;display:flex;flex-direction:column;background:var(--white);border:1px solid var(--line);box-shadow:0 13px 28px rgba(15,55,73,.13);padding:7px;z-index:90}
.language-options a{display:block;padding:11px 13px;font-size:12px;font-weight:700;color:var(--cyan);white-space:nowrap}
.language-options a:hover,.language-options a[aria-current=page]{background:var(--cyan-pale);color:var(--red)}
.language-options a:focus-visible{outline:2px solid var(--red);outline-offset:-2px}
.mobile-nav{display:none}
.eyebrow{display:flex;align-items:center;gap:11px;font-size:11px;letter-spacing:.16em;font-weight:800;text-transform:uppercase;color:var(--cyan)}
.eyebrow:before{content:'';height:8px;width:8px;flex:0 0 8px;background:var(--red);border-radius:50%}
h1,h2,h3,h4,p{margin-top:0}
.display{font:650 clamp(56px,6.6vw,105px)/1.04 'Manrope',Arial,sans-serif;letter-spacing:-.079em}
.section-title{font:650 clamp(37px,4.3vw,61px)/1.11 'Manrope',Arial,sans-serif;letter-spacing:-.068em}
.page-title{font:650 clamp(51px,6vw,83px)/1.09 'Manrope',Arial,sans-serif;letter-spacing:-.073em}
.lead{font-size:19px;line-height:1.68;color:var(--muted)}
.muted{color:var(--muted)}
.mini{font-size:11px;letter-spacing:.12em;font-weight:800;text-transform:uppercase}
.btn{display:inline-flex;align-items:center;justify-content:space-between;gap:25px;background:var(--cyan);color:var(--white);padding:18px 23px;font-size:12px;font-weight:800;transition:background .2s,transform .2s}
.btn:hover{transform:translateY(-2px)}
.btn.ghost{color:var(--cyan);background:transparent;border:1px solid var(--line-strong)}
.btn.ghost:hover{background:var(--cyan-pale)}
.text-link{display:inline-flex;align-items:center;gap:14px;font-weight:800;font-size:13px;color:var(--cyan)}
.text-link:hover{text-decoration:underline;text-underline-offset:5px}
.card{background:var(--white);border:1px solid var(--line);padding:28px;box-shadow:0 8px 28px rgba(20,58,72,.035)}
.card a:hover{text-decoration:underline}
.section{padding:103px 0}
.section-alt{background:var(--cyan-pale)}
.section-light{background:var(--white)}
.section-head{display:flex;align-items:end;justify-content:space-between;gap:35px;margin-bottom:38px}
.section-head h2{margin:15px 0 0}
.section-head p{max-width:320px;color:var(--muted);font-size:14px;line-height:1.75;margin:0}
.site-footer{background:var(--navy);color:var(--white);padding:58px 0 65px}
.footer-columns{display:grid;grid-template-columns:1.25fr .7fr 1fr;gap:45px}
.footer-mark{font:800 21px/1 'Manrope',sans-serif;letter-spacing:-.06em}
.footer-site-links{display:grid;grid-template-columns:repeat(2,max-content);column-gap:23px;row-gap:12px;margin-top:22px}
.footer-site-links a{font-size:12px;font-weight:650;color:var(--on-dark);text-decoration:underline;text-underline-offset:4px;text-decoration-color:var(--line-strong)}
.footer-site-links a:hover,.footer-site-links a:focus-visible{color:var(--white);text-decoration-color:var(--red-light)}

.site-footer p{color:var(--on-dark);font-size:13px;line-height:1.8;margin:20px 0 0}
.footer-links{display:flex;flex-direction:column;gap:14px;font-weight:600;font-size:13px}
.footer-links a:hover,.footer-email a:hover{color:var(--red-light)}
.footer-email{display:flex;flex-direction:column;align-items:flex-start;gap:17px}
.footer-email span,.footer-email small{font-size:10px;letter-spacing:.1em;color:var(--line-strong)}
.footer-email a{font-size:14px;font-weight:700;overflow-wrap:anywhere}
.page-hero{padding:96px 0 75px;border-bottom:1px solid var(--line);background:var(--offwhite)}
.page-hero h1{margin:22px 0 20px;max-width:1070px}
.page-hero .lead{max-width:800px;margin:0}
.paper-list{border-top:1px solid var(--line)}
.paper{display:grid;grid-template-columns:85px 1fr 35px;gap:25px;border-bottom:1px solid var(--line);padding:27px 0}
.paper .year{font:700 15px 'Manrope',sans-serif;color:var(--red)}
.paper h3{font:650 clamp(17px,1.75vw,23px)/1.4 'Manrope',sans-serif;letter-spacing:-.035em;margin:0 0 10px}
.paper p{font-size:13px;color:var(--muted);line-height:1.6;margin:0}
.paper .arrow{font-size:22px;color:var(--cyan)}
.paper:hover h3{color:var(--cyan)}
.tag{font-size:10px;font-weight:800;letter-spacing:.1em;color:var(--cyan);text-transform:uppercase}
@media(max-width:1180px){.desktop-contact{display:none}.desktop-nav{gap:13px}}
@media(max-width:1040px){
  .desktop-nav{display:none}
  .mobile-nav{display:block;margin-left:auto;position:relative}
  .mobile-nav summary{cursor:pointer;list-style:none;color:var(--cyan);font-size:13px;font-weight:800}
  .mobile-nav summary::-webkit-details-marker{display:none}
  .mobile-nav summary span{margin-left:7px}
  .mobile-nav nav{position:absolute;right:0;top:36px;min-width:235px;background:var(--white);box-shadow:0 16px 30px rgba(15,55,73,.14);border:1px solid var(--line);padding:15px;display:flex;flex-direction:column;max-height:75vh;overflow-y:auto}
  .mobile-nav a{padding:10px;font-size:14px}
  .footer-columns{grid-template-columns:1fr 1fr}
}
@media(max-width:760px){.container{width:min(100% - 40px,1360px)}.header-content{min-height:75px;gap:11px}.language-picker summary{min-height:35px;min-width:46px;padding:7px 8px}.wordmark{font-size:17px}.mark{width:30px;height:30px;font-size:20px}.desktop-nav{display:none}.mobile-nav{display:block;margin-left:auto;position:relative}.mobile-nav summary{cursor:pointer;list-style:none;color:var(--cyan);font-size:13px;font-weight:800}.mobile-nav summary::-webkit-details-marker{display:none}.mobile-nav summary span{margin-left:7px}.mobile-nav nav{position:absolute;right:0;top:36px;min-width:220px;background:var(--white);box-shadow:0 16px 30px rgba(15,55,73,.14);border:1px solid var(--line);padding:15px;display:flex;flex-direction:column}.mobile-nav a{padding:10px;font-size:14px}.display{font-size:clamp(47px,11vw,75px)}.section{padding:72px 0}.section-head{display:block}.section-head p{margin-top:20px}.footer-columns{grid-template-columns:1fr;gap:35px}.paper{grid-template-columns:55px 1fr 18px;gap:10px}.page-hero{padding:71px 0 60px}}

@media(max-width:360px){.wordmark .mark{display:none}.wordmark{font-size:16px}.header-content{gap:8px}}
/* Aparició progressiva en desplaçar-se: manté el contingut llegible sense JavaScript. */
.scroll-progress{height:3px;position:fixed;top:0;left:0;right:0;background:var(--cyan);z-index:100;transform-origin:left;transform:scaleX(0);pointer-events:none}
main section[id]{scroll-margin-top:96px}
.motion-ready [data-reveal]{opacity:0;transform:translateY(24px);transition:opacity .8s ease,transform .8s cubic-bezier(.2,.75,.25,1)}
.motion-ready [data-reveal].is-visible{opacity:1;transform:translateY(0)}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{transition-duration:0s!important;animation:none!important}.motion-ready [data-reveal]{opacity:1!important;transform:none!important}}

</style>
