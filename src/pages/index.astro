<script>
  // En arribar des de la subpàgina del laboratori, obre la dimensió enllaçada.
  function openLabFromHash() {
    if (!window.location.hash) return;
    const id = decodeURIComponent(window.location.hash.slice(1));
    const target = document.getElementById(id);
    const disclosure = target?.matches('details.lab-disclosure') ? target : target?.closest('details.lab-disclosure');
    if (disclosure) {
      disclosure.open = true;
      // Obre el desplegable abans de desplaçar-hi la pantalla: un enllaç
      // directe també mostra el contingut en mòbils i navegadors amb memòria de scroll.
      window.requestAnimationFrame(() => {
        const destination = target.matches('details.lab-disclosure') ? target : disclosure;
        destination.scrollIntoView({block:'start',behavior:'instant'});
      });
    }
  }
  openLabFromHash();
  window.addEventListener('hashchange', openLabFromHash);
</script>
