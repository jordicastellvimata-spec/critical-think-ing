---
const base = import.meta.env.BASE_URL;
const topics = [
  { num: '01', title: 'Pensament crític', en: 'Critical thinking', desc: 'Com construïm criteri, formulem preguntes i interpretem la realitat.' },
  { num: '02', title: 'Educació democràtica', en: 'Democratic education', desc: 'Ciutadania, participació i pràctiques democràtiques a l’escola.' },
  { num: '03', title: 'Alfabetització mediàtica', en: 'Media literacy', desc: 'Desinformació, discursos d’odi i cultura digital crítica.' },
  { num: '04', title: 'Didàctica de les ciències socials', en: 'Social sciences education', desc: 'Aprendre a comprendre el món per poder-lo transformar.' },
];
const links = [
  { text: 'Perfil UAB', url: 'https://www.uab.cat/' },
  { text: 'ORCID', url: 'https://orcid.org/0000-0002-6487-5477' },
];
---
<!doctype html>
<html lang="ca">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#efeee9" />
  <meta name="description" content="Jordi Castellví Mata. Professor universitari i investigador en pensament crític, didàctica de les ciències socials i educació democràtica." />
  <title>Jordi Castellví Mata — Pensament crític, recerca i educació</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root{font-family:'DM Sans',Arial,sans-serif;color:#202723;background:#efeee9;font-synthesis:none;scroll-behavior:smooth}
    *{box-sizing:border-box}body{margin:0}a{color:inherit;text-decoration:none}button{font:inherit}
    .shell{max-width:1540px;padding:0 6.2%;margin:auto}.top{border-bottom:1px solid #d5d6d0}
    header{min-height:91px;display:flex;align-items:center;justify-content:space-between;gap:24px}
    .brand{display:flex;align-items:center;gap:12px;font:800 20px 'Manrope',sans-serif;letter-spacing:-.08em;white-space:nowrap}
    .brand-symbol{width:34px;height:34px;border:2px solid #242d27;border-radius:50%;display:grid;place-items:center;font-size:22px;font-weight:600;line-height:1;transform:rotate(-35deg)}
    nav{display:flex;align-items:center;gap:34px;font-size:13px;font-weight:700}nav a:hover,.active{color:#7b563f}
    .language{display:flex;gap:8px;align-items:center;border-left:1px solid #cbd0c9;padding-left:25px;font-size:11px;letter-spacing:.06em}
    .language span:first-child{font-weight:800;border-bottom:1.5px solid;padding-bottom:3px}.language span:not(:first-child){opacity:.45}
    .hero{padding-top:85px;padding-bottom:105px;min-height:650px;position:relative;overflow:hidden}
    .eyebrow{display:flex;align-items:center;gap:12px;text-transform:uppercase;font-weight:800;letter-spacing:.17em;font-size:11px;color:#516358}
    .eyebrow:before{content:'';height:8px;width:8px;background:#9a583d;border-radius:100%}
    .hero h1{font-family:'Manrope',Arial,sans-serif;font-weight:600;letter-spacing:-.075em;line-height:1.045;font-size:clamp(52px,6.15vw,100px);max-width:1030px;margin:32px 0 29px;position:relative;z-index:2}
    .hero h1 em{font-weight:500;font-style:normal;color:#a46346}
    .hero-bottom{display:flex;justify-content:space-between;align-items:flex-end;gap:35px;position:relative;z-index:2}
    .hero-description{max-width:540px;font-size:18px;line-height:1.7;color:#58625b;margin:0}
    .button{display:inline-flex;align-items:center;justify-content:center;gap:34px;background:#273e33;color:#fff;padding:18px 24px;font-size:12px;letter-spacing:.04em;font-weight:800;white-space:nowrap;transition:transform .2s,background .2s}
    .button:hover{transform:translateY(-2px);background:#385a47}
    .button .arrow{font-size:19px;font-weight:400}
    .graphic{position:absolute;right:-65px;top:20px;width:510px;height:580px;opacity:.68;pointer-events:none}
    .graphic:before,.graphic:after{content:'';position:absolute;border:1px solid #bfc7ba;border-radius:50%;width:460px;height:460px;right:0;top:0}
    .graphic:after{width:315px;height:315px;right:70px;top:73px;border-color:#c4c9c1}
    .graphic i{display:block;position:absolute;width:180px;height:180px;border-radius:50%;right:136px;top:143px;background:#a65e42;opacity:.14}
    .section-dark{background:#243b31;color:#f4f1e9;padding:80px 0 95px}
    .section-head{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;margin-bottom:44px}
    .section-title{font:600 clamp(34px,4vw,56px)/1.1 'Manrope',sans-serif;letter-spacing:-.06em;margin:15px 0 0}
    .section-note{max-width:270px;font-size:13px;line-height:1.7;color:#bfc9bf;margin:15px 0}
    .section-dark .eyebrow{color:#b2c3b0}.section-dark .eyebrow:before{background:#e1a078}
    .topics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid #718378;border-bottom:1px solid #718378}
    .topic{padding:32px 28px 18px 0;min-height:280px;border-right:1px solid #718378;margin-right:24px}
    .topic:last-child{border-right:0;margin-right:0}
    .num{font-size:11px;color:#c29d86;letter-spacing:.15em;font-weight:700}
    .topic h3{font:600 23px/1.25 'Manrope',sans-serif;letter-spacing:-.05em;margin:44px 0 8px}
    .english{font-size:11px;color:#b8c7bd;text-transform:uppercase;letter-spacing:.11em}
    .topic p{color:#c9d3c9;font-size:13px;line-height:1.65;margin-top:25px}
    .light{padding-top:95px;padding-bottom:105px}
    .two-col{display:grid;grid-template-columns:1.12fr .88fr;gap:9%;align-items:start}
    .light h2{font:600 clamp(38px,4.2vw,60px)/1.15 'Manrope',sans-serif;letter-spacing:-.065em;margin:22px 0}
    .light h2 span{color:#a46346}
    .bio{font-size:17px;line-height:1.85;color:#536058;max-width:540px}
    .small-label{font-size:11px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:#68796d}
    .link-list{border-top:1px solid #bfc9bd;margin-top:20px}
    .link-list a{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #bfc9bd;padding:19px 2px;font-size:14px;font-weight:700}
    .link-list a span:last-child{font-size:20px;font-weight:400;color:#9a6447}
    .aside{background:#e6e4db;padding:34px 37px;margin-top:10px}
    .aside .large{font:500 27px/1.35 'Manrope',sans-serif;letter-spacing:-.055em;margin:24px 0 35px}
    .aside .small{font-size:12px;color:#687369;line-height:1.6}
    .footer{background:#e3e5dc;border-top:1px solid #c8cec3;padding:34px 0}
    .footer-inner{display:flex;justify-content:space-between;gap:24px;align-items:center;font-size:12px;color:#58685b}
    .footer strong{font-size:14px;color:#263a30}.status{display:flex;gap:9px;align-items:center}.status:before{content:'';height:8px;width:8px;border-radius:50%;background:#a56447}
    @media(max-width:1050px){nav{gap:16px}.topics{grid-template-columns:repeat(2,minmax(0,1fr))}.topic:nth-child(2){border-right:none}.topic{margin-right:15px;min-height:250px}.graphic{opacity:.3}}
    @media(max-width:700px){.shell{padding:0 6%}header{min-height:76px}.brand{font-size:16px}.brand-symbol{width:28px;height:28px;font-size:18px}nav a:not(.mobile-keep){display:none}nav{gap:12px}.language{padding-left:12px}.hero{padding-top:73px;padding-bottom:84px;min-height:0}.hero h1{font-size:clamp(49px,12vw,75px);margin:30px 0}.hero-bottom{flex-direction:column;align-items:flex-start}.hero-description{font-size:16px}.graphic{right:-250px}.section-dark{padding:65px 0}.section-head{display:block}.section-note{margin-top:22px}.topics{grid-template-columns:1fr}.topic{border-right:0;border-bottom:1px solid #718378;min-height:0;margin:0;padding:30px 0}.topic:last-child{border-bottom:0}.topic h3{margin-top:22px}.topic p{margin:16px 0 0}.light{padding-top:70px;padding-bottom:70px}.two-col{grid-template-columns:1fr;gap:24px}.aside{padding:25px}.footer-inner{flex-direction:column;align-items:flex-start}}
    @media(prefers-reduced-motion:reduce){:root{scroll-behavior:auto}.button{transition:none}}
  </style>
</head>
<body>
  <div class="top">
    <header class="shell">
      <a class="brand" href={base} aria-label="Jordi Castellví Mata — inici"><span class="brand-symbol" aria-hidden="true">↗</span><span>critical-think.ing</span></a>
      <nav aria-label="Navegació principal">
        <a href="#recerca">Recerca</a>
        <a href="#sobre-mi">Sobre mi</a>
        <a href="#enllacos">Enllaços</a>
        <div class="language" aria-label="Idioma: català; altres idiomes en preparació"><span>CAT</span><span>ES</span><span>EN</span></div>
      </nav>
    </header>
  </div>
  <main>
    <section class="hero shell" aria-labelledby="hero-title">
      <div class="graphic" aria-hidden="true"><i></i></div>
      <div class="eyebrow">Recerca · Educació · Pensament crític</div>
      <h1 id="hero-title">Pensar el món.<br /><em>Transformar-lo.</em></h1>
      <div class="hero-bottom">
        <p class="hero-description">Soc <strong>Jordi Castellví Mata</strong>, professor universitari i investigador en didàctica de les ciències socials. Investigo com l'educació pot formar ciutadans crítics, participatius i compromesos amb la democràcia.</p>
        <a class="button" href="#recerca">Explora la meva recerca <span class="arrow" aria-hidden="true">↗</span></a>
      </div>
    </section>
    <section class="section-dark" id="recerca" aria-labelledby="recerca-title">
      <div class="shell">
        <div class="section-head">
          <div><div class="eyebrow">Àmbits d'investigació</div><h2 class="section-title" id="recerca-title">Les preguntes que<br />mouen la recerca.</h2></div>
          <p class="section-note">Quatre àmbits connectats per una mateixa idea: educar per comprendre, qüestionar i participar en el món que compartim.</p>
        </div>
        <div class="topics">
          {topics.map((topic) => <article class="topic"><span class="num">{topic.num} / 04</span><h3>{topic.title}</h3><div class="english">{topic.en}</div><p>{topic.desc}</p></article>)}
        </div>
      </div>
    </section>
    <section class="light shell" id="sobre-mi" aria-labelledby="about-title">
      <div class="two-col">
        <div>
          <div class="eyebrow">Una mica sobre mi</div>
          <h2 id="about-title">La recerca com una manera de <span>fer preguntes.</span></h2>
          <p class="bio">Treballo a la <strong>Universitat Autònoma de Barcelona</strong> en la formació de futurs mestres i en projectes de recerca sobre ciutadania, pensament crític i educació democràtica. M'interessa especialment la relació entre allò que passa a les aules i els grans debats socials contemporanis.</p>
          <p class="bio">Aquest espai vol reunir la meva trajectòria, els projectes en què participo i les idees que considero que val la pena compartir.</p>
        </div>
        <aside class="aside" id="enllacos">
          <div class="small-label">En construcció · Versió 01</div>
          <p class="large">Una web per connectar recerca, docència i debat públic.</p>
          <div class="small-label">Perfils i recursos</div>
          <div class="link-list">{links.map((link)=><a href={link.url} target="_blank" rel="noopener noreferrer"><span>{link.text}</span><span aria-hidden="true">↗</span></a>)}</div>
          <p class="small">Pròximament: publicacions, projectes, materials docents i versions en castellà i anglès.</p>
        </aside>
      </div>
    </section>
  </main>
  <footer class="footer"><div class="shell footer-inner"><div><strong>Jordi Castellví Mata</strong><br />Didàctica de les Ciències Socials · UAB</div><span class="status">Una web en construcció, una idea en moviment.</span><span>© {new Date().getFullYear()}</span></div></footer>
</body>
</html>
