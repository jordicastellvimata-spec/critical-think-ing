/* Relat visual basat en scroll: portada fixa, titular que creix i aparició de la recerca.
   Sense afegir textos, gràfics o capes entre les seccions. */
:global(html.apple-scroll-ready) .hero-scroll-scene{
  height:185svh;
  position:relative;
  background:var(--paper);
}
:global(html.apple-scroll-ready) .hero-scroll-scene>.hero{
  position:sticky;
  top:var(--hero-nav-height,92px);
  height:calc(100svh - var(--hero-nav-height,92px));
  min-height:0;
  display:flex;
  flex-direction:column;
  isolation:isolate;
}
:global(html.apple-scroll-ready) .hero-scroll-scene .hero-grid{
  display:flex;
  flex:1;
  justify-content:center;
  align-items:center;
  padding-top:clamp(22px,3.5vh,60px);
  padding-bottom:clamp(22px,3.5vh,60px);
}
:global(html.apple-scroll-ready) .hero-scroll-scene .hero-copy{width:100%;min-width:0}
:global(html.apple-scroll-ready) .hero-scroll-scene .hero-copy h1{
  transform:translate3d(0,var(--headline-lift,0px),0) scale(var(--headline-zoom,1));
  transform-origin:center center;
  opacity:var(--headline-opacity,1);
  will-change:transform,opacity;
}
:global(html.apple-scroll-ready) .hero-scroll-scene .hero-copy .eyebrow,
:global(html.apple-scroll-ready) .hero-scroll-scene .hero-copy .lead,
:global(html.apple-scroll-ready) .hero-scroll-scene :global(.hero-socials),
:global(html.apple-scroll-ready) .hero-scroll-scene .hero-actions{
  opacity:var(--support-opacity,1);
  transform:translate3d(0,var(--support-shift,0px),0);
  will-change:transform,opacity;
}
:global(html.apple-scroll-ready) .hero-scroll-scene .hero-foot{
  position:relative;z-index:2;
  opacity:var(--support-opacity,1);
  transform:translate3d(0,var(--foot-shift,0px),0);
}
:global(html.apple-scroll-ready) .hero-scroll-scene>.hero:after{
  content:'';
  position:absolute;inset:0;
  background:var(--white);
  opacity:var(--hero-wash,0);
  pointer-events:none;
  z-index:1;
}
:global(html.apple-scroll-ready) .topics-section{
  position:relative;
  z-index:2;
}
:global(html.apple-scroll-ready) .topics-section .section-head{
  opacity:var(--research-head-opacity,1);
  transform:translate3d(0,var(--research-head-y,0px),0);
  will-change:transform,opacity;
}
