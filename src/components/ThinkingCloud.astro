---
const phrases = [
  { text: 'No tots els laboratoris tenen provetes, tubs d’assaig o matrassos Erlenmeyer.', pieces: ['No tots els', 'laboratoris', 'tenen', 'provetes,', 'tubs d’assaig', 'o matrassos', 'Erlenmeyer.'] },
  { text: 'Les ciències socials també són ciències.', pieces: ['Les', 'ciències', 'socials', 'també', 'són', 'ciències.'] },
  { text: 'Totes les ciències de l’educació són ciències socials.', pieces: ['Totes les', 'ciències de', 'l’educació', 'són', 'ciències', 'socials.'] },
  { text: 'Com seria un laboratori de pensament crític?', pieces: ['Com seria', 'un laboratori', 'de pensament', 'crític?'] }
];
// Barregem els fragments per construir un sol paisatge de paraules, no quatre targetes.
const order = [
 [0,0],[2,0],[1,0],[3,0],
 [1,1],[0,1],[3,1],[2,1],
 [2,2],[1,2],[0,2],[3,2],
 [0,3],[2,3],[1,3],[3,3],
 [1,4],[0,4],[2,4],[1,5],
 [0,5],[2,5],[0,6]
];
const items=order.map(([group,part],i)=>({group,part,i,text:phrases[group].pieces[part]}));
---
<div class="thinking-cloud" data-thinking-cloud aria-label="Núvol interactiu de quatre frases sobre les ciències socials i els laboratoris">
 <p class="cloud-instruction">Descobreix quatre idees: passa per les paraules o toca-les</p>
 <div class="cloud-field" role="group" aria-label="Toca qualsevol paraula per il·luminar la seva frase">
   {items.map(item=><button type="button" class={`cloud-word cloud-word-${item.i%5} cloud-group-${item.group}`} data-group={item.group} data-part={item.part} aria-label={`${item.text}. Frase ${item.group+1}: ${phrases[item.group].text}`} aria-pressed="false">{item.text}</button>)}
 </div>
 <span class="sr-only" aria-live="polite" data-cloud-announcement></span>
</div>
<style>
.thinking-cloud{width:100%;min-width:0;color:#fff}
.cloud-instruction{font:700 10px/1.5 'Manrope',sans-serif;letter-spacing:.055em;color:#a4c9d2;text-align:center;margin:0 0 18px}
.cloud-field{min-height:350px;display:flex;flex-wrap:wrap;align-content:center;align-items:center;justify-content:center;gap:8px 13px;padding:18px 5px;position:relative}
.cloud-word{appearance:none;border:0;background:transparent;padding:5px 1px;margin:0;font:750 clamp(15px,1.55vw,23px)/1.12 'Manrope',sans-serif;letter-spacing:-.045em;white-space:nowrap;cursor:pointer;color:#d2e6eb;opacity:.82;transition:opacity .2s,color .2s,transform .2s,text-shadow .2s}
.cloud-word-0{font-size:clamp(21px,2.2vw,32px)}
.cloud-word-1{font-size:clamp(16px,1.7vw,25px)}
.cloud-word-2{font-size:clamp(18px,1.9vw,28px)}
.cloud-word-3{font-size:clamp(15px,1.5vw,22px)}
.cloud-word-4{font-size:clamp(19px,2vw,29px)}
.cloud-group-0{color:#b8e0e8}.cloud-group-1{color:#ffb7bf}.cloud-group-2{color:#e5f3f5}.cloud-group-3{color:#8ad7e4}
.cloud-field.is-active .cloud-word{opacity:.17;color:#a4c9d2;text-shadow:none}
.cloud-field.is-active .cloud-word.is-lit{opacity:1;color:#fff;text-shadow:0 0 16px rgba(142,229,237,.28)}
.cloud-field.is-active .cloud-group-1.is-lit{color:#ffb7bf}
.cloud-field.is-active .cloud-group-3.is-lit{color:#80e7f1}
.cloud-word:hover{transform:translateY(-2px)}
.cloud-word:focus-visible{outline:2px solid #ffb7bf;outline-offset:4px;border-radius:3px}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:1100px){.cloud-field{min-height:300px;gap:7px 11px}.cloud-word{font-size:clamp(14px,2vw,21px)}.cloud-word-0{font-size:clamp(19px,2.5vw,27px)}.cloud-word-4{font-size:clamp(18px,2.3vw,25px)}}
@media(max-width:760px){.cloud-field{min-height:0;gap:5px 9px;padding:12px 0 22px}.cloud-word{font-size:clamp(13px,3.6vw,19px);white-space:normal;overflow-wrap:normal}.cloud-word-0{font-size:clamp(17px,4.8vw,24px)}.cloud-word-4{font-size:clamp(16px,4.4vw,23px)}.cloud-instruction{margin-bottom:12px}}
@media(prefers-reduced-motion:reduce){.cloud-word{transition:none}}
</style>
<script>
document.querySelectorAll('[data-thinking-cloud]').forEach(cloud=>{
 const field=cloud.querySelector('.cloud-field');
 const words=Array.from(cloud.querySelectorAll('[data-group]'));
 const announcement=cloud.querySelector('[data-cloud-announcement]');
 const locale=document.documentElement.lang;
 const translations={
  es:{
   instruction:'Descubre cuatro ideas: pasa el cursor por las palabras o tócalas',
   cloudLabel:'Nube interactiva de cuatro frases sobre las ciencias sociales y los laboratorios',
   fieldLabel:'Toca cualquier palabra para iluminar su frase',
   phraseLabel:'Frase',
   phrases:[
    {text:'No todos los laboratorios tienen probetas, tubos de ensayo o matraces Erlenmeyer.',pieces:['No todos los','laboratorios','tienen','probetas,','tubos de ensayo','o matraces','Erlenmeyer.']},
    {text:'Las ciencias sociales también son ciencias.',pieces:['Las','ciencias','sociales','también','son','ciencias.']},
    {text:'Todas las ciencias de la educación son ciencias sociales.',pieces:['Todas las','ciencias de','la educación','son','ciencias','sociales.']},
    {text:'¿Cómo sería un laboratorio de pensamiento crítico?',pieces:['¿Cómo sería','un laboratorio','de pensamiento','crítico?']}
   ]
  },
  en:{
   instruction:'Discover four ideas: hover over the words or tap them',
   cloudLabel:'Interactive word cloud with four statements about social sciences and laboratories',
   fieldLabel:'Tap any word to highlight its statement',
   phraseLabel:'Statement',
   phrases:[
    {text:'Not all laboratories have test tubes, pipettes or Erlenmeyer flasks.',pieces:['Not all','laboratories','have','test tubes,','pipettes','or Erlenmeyer','flasks.']},
    {text:'The social sciences are sciences too.',pieces:['The','social','sciences','are','sciences','too.']},
    {text:'All educational sciences are social sciences.',pieces:['All','educational','sciences','are','social','sciences.']},
    {text:'What might a critical thinking laboratory look like?',pieces:['What might','a laboratory','for critical thinking','look like?']}
   ]
  },
  fr:{
   instruction:'Découvrez quatre idées : survolez les mots ou touchez-les',
   cloudLabel:'Nuage de mots interactif présentant quatre phrases sur les sciences sociales et les laboratoires',
   fieldLabel:'Touchez un mot pour faire ressortir sa phrase',
   phraseLabel:'Phrase',
   phrases:[
    {text:'Tous les laboratoires ne disposent pas d’éprouvettes, de tubes à essai ou de fioles Erlenmeyer.',pieces:['Tous les','laboratoires','ne disposent pas','d’éprouvettes,','de tubes à essai','ou de fioles','Erlenmeyer.']},
    {text:'Les sciences sociales sont aussi des sciences.',pieces:['Les','sciences','sociales','sont aussi','des','sciences.']},
    {text:'Toutes les sciences de l’éducation sont des sciences sociales.',pieces:['Toutes les','sciences de','l’éducation','sont des','sciences','sociales.']},
    {text:'À quoi ressemblerait un laboratoire de pensée critique ?',pieces:['À quoi ressemblerait','un laboratoire','de pensée','critique ?']}
   ]
  }
 };
 const translated=translations[locale];
 const catalanPhrases=[
  'No tots els laboratoris tenen provetes, tubs d’assaig o matrassos Erlenmeyer.',
  'Les ciències socials també són ciències.',
  'Totes les ciències de l’educació són ciències socials.',
  'Com seria un laboratori de pensament crític?'
 ];
 const phrases=translated?translated.phrases.map(p=>p.text):catalanPhrases;
 if(translated){
  cloud.setAttribute('aria-label',translated.cloudLabel);
  field.setAttribute('aria-label',translated.fieldLabel);
  cloud.querySelector('.cloud-instruction').textContent=translated.instruction;
  words.forEach(word=>{
   const group=Number(word.dataset.group);
   const part=Number(word.dataset.part);
   const piece=translated.phrases[group].pieces[part];
   word.textContent=piece;
   word.setAttribute('aria-label',piece+'. '+translated.phraseLabel+' '+(group+1)+': '+phrases[group]);
  });
 }
 let selected=null;
 const show=(group,announce=false)=>{
  field.classList.toggle('is-active',group!==null);
  words.forEach(word=>{
   const lit=group!==null&&Number(word.dataset.group)===group;
   word.classList.toggle('is-lit',lit);
   word.setAttribute('aria-pressed',String(lit));
  });
  if(announce)announcement.textContent=group===null?'':phrases[group];
 };
 words.forEach(word=>{
  const group=Number(word.dataset.group);
  word.addEventListener('pointerenter',e=>{if(e.pointerType==='mouse')show(group)});
  word.addEventListener('focus',()=>show(group));
  word.addEventListener('click',()=>{selected=group;show(group,true)});
 });
 field.addEventListener('pointerleave',e=>{if(e.pointerType==='mouse')show(selected)});
 field.addEventListener('focusout',e=>{if(!field.contains(e.relatedTarget))show(selected)});
});
</script>