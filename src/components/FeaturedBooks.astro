---
import { featuredBooks } from '../data/featuredBooks';
const { compact = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const coverFor = (book) => ('coverUrl' in book && book.coverUrl) ? (book.coverUrl.startsWith('https://') ? book.coverUrl : base + '/' + book.coverUrl.replace(/^\/+/, '')) : undefined;
---
<div class:list={['books-showcase', { 'books-compact': compact }]}>
  <div class="books-heading">
    <div class="eyebrow">Obres col·lectives · Didàctica de les ciències socials</div>
    <h3>Llibres</h3>
  </div>
  <div class="books-grid">
    {featuredBooks.map((book) => (
      <article class="book-feature">
        <div class={'book-cover book-' + book.coverVariant}>
          <div class="book-cover-fallback" aria-hidden="true">
            <div class="book-publisher">{book.publisher}</div>
            <div class="cover-emblem">{book.coverVariant === 'conflict' ? '✳' : '?'}</div>
            <div class="cover-title">{book.title}</div>
            <div class="cover-bottom-rule" />
          </div>
          {'coverUrl' in book && book.coverUrl && (
            <img
              class="official-book-cover"
              src={coverFor(book)}
              alt={'Portada del llibre ' + book.title}
              loading="lazy"
              decoding="async"
              onerror="this.style.display='none'"
            />
          )}
        </div>
        <div class="book-details">
          <div class="book-kicker">{book.role} <span aria-hidden="true">·</span> {book.year}</div>
          <h4>{book.title}</h4>
          <p class="book-subtitle">{book.subtitle}</p>
          <p class="book-contributors">{book.contributors}</p>
          <p class="book-description">{book.description}</p>
          <div class="book-links">
            <a href={book.url} target="_blank" rel="noopener noreferrer">Fitxa editorial <span aria-hidden="true">↗</span></a>
            <a href={book.secondaryUrl} target="_blank" rel="noopener noreferrer">{book.secondaryLabel} <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </article>
    ))}
  </div>
</div>
<style>
.books-showcase{padding:12px 0 52px}
.books-heading{display:flex;align-items:end;justify-content:space-between;gap:30px;margin:2px 0 22px}
.books-heading h3{font:650 clamp(29px,3.5vw,43px)/1.1 'Manrope',sans-serif;letter-spacing:-.065em;margin:17px 0 0;color:#172d35}
.books-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.book-feature{background:#fff;border:1px solid #d4e2e6;display:grid;grid-template-columns:155px minmax(0,1fr);gap:25px;min-height:360px;padding:25px;box-shadow:0 9px 25px rgba(20,53,67,.045);transition:transform .25s ease,box-shadow .25s ease}
.book-feature:hover{transform:translateY(-3px);box-shadow:0 17px 34px rgba(20,53,67,.08)}
.book-cover{align-self:start;width:155px;aspect-ratio:2/3;position:relative;overflow:hidden;border:1px solid #bcced5;box-shadow:4px 7px 14px rgba(20,51,67,.16);background:#dbe9f1}
.book-cover-fallback{height:100%;padding:17px 12px 14px;display:flex;flex-direction:column;align-items:flex-start;background:linear-gradient(155deg,#173f58 0%,#1e6282 65%,#173f58 100%);color:#fff}
.book-conflict .book-cover-fallback{background:linear-gradient(157deg,#db7956 0%,#c45e3f 48%,#184e69 49%,#19465e 100%)}
.book-publisher{font:800 10px/1.1 'Manrope',sans-serif;letter-spacing:.07em}
.cover-emblem{flex:1;display:flex;align-items:center;font:500 72px/1 'Manrope',sans-serif;color:#f0b48e}
.cover-title{font:750 16px/1.25 'Manrope',sans-serif;letter-spacing:-.05em;overflow-wrap:break-word}
.cover-bottom-rule{height:2px;width:75%;background:#f0b48e;margin-top:14px}
.official-book-cover{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center top}
.book-details{display:flex;flex-direction:column;align-items:flex-start;min-width:0}
.book-kicker{color:#ac5c41;font-weight:800;letter-spacing:.08em;font-size:10px;line-height:1.5}
.book-details h4{font:650 clamp(19px,1.8vw,25px)/1.23 'Manrope',sans-serif;letter-spacing:-.047em;margin:13px 0 11px;color:#172d35}
.book-subtitle{font-size:12px;line-height:1.5;font-weight:700;color:#1d5978;margin:0 0 13px}
.book-contributors{font-size:11px;line-height:1.5;color:#526876;margin:0 0 13px}
.book-description{font-size:12px;line-height:1.66;color:#526876;margin:0 0 19px}
.book-links{margin-top:auto;display:flex;flex-wrap:wrap;gap:14px 17px}
.book-links a{font-size:11px;font-weight:800;line-height:1.5;color:#1a5e81;border-bottom:1px solid currentColor;padding-bottom:3px}
.book-links a:hover{color:#c05e3c}
.books-compact{padding:0}
@media(max-width:1190px){.books-grid{grid-template-columns:1fr}.book-feature{grid-template-columns:165px minmax(0,1fr);min-height:0}.book-cover{width:165px}}
@media(max-width:650px){.book-feature{grid-template-columns:100px minmax(0,1fr);gap:17px;padding:18px}.book-cover{width:100px}.book-cover-fallback{padding:12px 8px}.book-publisher{font-size:8px}.cover-title{font-size:11px}.cover-emblem{font-size:44px}.book-details h4{font-size:19px}.book-kicker{font-size:9px}.book-description{font-size:12px}.book-links{gap:11px}.books-heading{display:block}}
@media(max-width:420px){.book-feature{grid-template-columns:1fr}.book-cover{width:126px}.book-details{width:100%}}
@media(prefers-reduced-motion:reduce){.book-feature{transition:none}}
</style>
