---
import Base from '../layouts/Base.astro';
import { publications, profile } from '../data/site';
const root=import.meta.env.BASE_URL.replace(/\/$/,''); const to=(s='')=>root+'/'+s.replace(/^\//,'');
---
<Base title="Publicacions" active="pubs" description="Selecció de publicacions científiques de Jordi Castellví Mata sobre pensament crític, educació i ciutadania democràtica.">
  <section class="page-hero"><div class="container"><div class="eyebrow">Producció científica</div><h1 class="page-title">Publicacions<span>.</span></h1><p class="lead">Una selecció de treballs sobre alfabetització crítica digital, ciutadania, educació democràtica, discursos d’odi i futurs. No és un llistat exhaustiu.</p></div></section>
  <section class="section"><div class="container">
    <div class="intro-row"><span class="mini">Articles seleccionats · 2020—2026</span><a class="text-link" href={profile.uab} target="_blank" rel="noopener noreferrer">Veure el catàleg complet a la UAB ↗</a></div>
    <div class="paper-list">{publications.map(p=><a class="paper" href={p.url} target="_blank" rel="noopener noreferrer"><span class="year">{p.year}</span><div><div class="tag">{p.venue}</div><h3>{p.title}</h3><p>{p.authors}</p></div><span class="arrow" aria-hidden="true">↗</span></a>)}</div>
    <div class="note-box"><p>La bibliografia està en procés de selecció i ordenació. Pots consultar-ne la versió més completa i actualitzada al <a href={profile.uab} target="_blank" rel="noopener noreferrer">Portal de Recerca UAB</a>, a <a href={profile.orcid} target="_blank" rel="noopener noreferrer">ORCID</a> o a <a href={profile.scholar} target="_blank" rel="noopener noreferrer">Google Scholar</a>.</p></div>
  </div></section>
</Base>
<style>
.page-hero h1 span{color:#d95f37}.intro-row{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:32px}.note-box{background:#eaf3f6;padding:28px 35px;margin-top:45px}.note-box p{font-size:14px;line-height:1.8;color:#426273;margin:0}.note-box a{font-weight:800;color:#176084}
@media(max-width:760px){.intro-row{display:flex;align-items:flex-start;flex-direction:column}}
</style>
