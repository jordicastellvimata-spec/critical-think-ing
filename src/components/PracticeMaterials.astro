---
import { barcanovaBooks, jesuitesProjects } from '../data/practiceMaterials';
---
<div class="practice-materials" aria-label="Materials curriculars i projectes educatius">
  <section class="material-group" aria-labelledby="barcanova-heading">
    <div class="material-group-head">
      <div>
        <span class="material-kicker">AUTORIA I DISSENY DE MATERIALS · PRIMÀRIA</span>
        <h3 id="barcanova-heading">Llibres de text de medi natural, social i cultural de <em>Barcanova.</em></h3>
      </div>
      <p>Col·laboració en els programes Experimenta i Entorn de Coneixement del Medi, amb vuit volums per a 3r i 4t de primària.</p>
    </div>
    <div class="coverflow" data-coverflow aria-label="Galeria dels vuit llibres de Barcanova">
      <div class="coverflow-top">
        <span class="coverflow-hint">Desplaça les portades per explorar els llibres</span>
        <div class="coverflow-controls">
          <button type="button" data-flow-prev aria-label="Llibre anterior" disabled>←</button>
          <output data-flow-count aria-live="polite">1 / {barcanovaBooks.length}</output>
          <button type="button" data-flow-next aria-label="Llibre següent">→</button>
        </div>
      </div>
      <div class="coverflow-rail">
        <div class="coverflow-track coverflow-books" data-flow-track tabindex="0" role="region" aria-roledescription="carrusel" aria-label="Llibres de text Barcanova">
          {barcanovaBooks.map((b, i) => (
            <article class="flow-item book-entry" data-flow-item data-active={i===0 ? 'true' : 'false'}>
              <a class="book-visual" href={'https://www.amazon.es/s?k='+b.isbn} target="_blank" rel="noopener noreferrer" aria-label={'Cercar a Amazon '+b.title+', ISBN '+b.isbn}>
                <span class="book-fallback" aria-hidden="true">
                  <small>BARCANOVA · INNOVA 2</small>
                  <strong>{b.title}</strong>
                  <span>{b.course}</span>
                </span>
                <img src={b.cover} alt={'Portada de '+b.title} loading="lazy" decoding="async" referrerpolicy="no-referrer-when-downgrade" onerror="this.style.display='none'" />
              </a>
              <div class="book-meta">
                <span>{b.series.toUpperCase()} · {b.course.toUpperCase()}</span>
                <h4>{b.title}</h4>
                <small>ISBN {b.isbn}</small>
                <div class="book-links">
                  <a href={'https://www.amazon.es/s?k='+b.isbn} target="_blank" rel="noopener noreferrer" aria-label={'Cercar a Amazon '+b.title}>Amazon ↗</a>
                  <a href={b.info} target="_blank" rel="noopener noreferrer" aria-label={'Veure la fitxa de '+b.title}>Fitxa del llibre ↗</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
    <p class="materials-note">Els enllaços d’Amazon cerquen cada ISBN; no pressuposen que el llibre hi estigui disponible.</p>
  </section>

  <section class="material-group jesuites-group" aria-labelledby="jesuites-heading">
    <div class="material-group-head">
      <div>
        <span class="material-kicker">DISSENY DE PROJECTES · SECUNDÀRIA</span>
        <h3 id="jesuites-heading">Projectes amb <em>Jesuïtes Educació.</em></h3>
      </div>
      <p>Vaig dissenyar cinc projectes de ciències socials i vaig compartir la coordinació de l’equip que va desenvolupar un total de 24 projectes per a tota l’etapa de l’ESO.</p>
    </div>
    <div class="coverflow" data-coverflow aria-label="Galeria dels cinc projectes de Jesuïtes Educació">
      <div class="coverflow-top">
        <span class="coverflow-hint">Desplaça les portades per explorar els projectes</span>
        <div class="coverflow-controls">
          <button type="button" data-flow-prev aria-label="Projecte anterior" disabled>←</button>
          <output data-flow-count aria-live="polite">1 / {jesuitesProjects.length}</output>
          <button type="button" data-flow-next aria-label="Projecte següent">→</button>
        </div>
      </div>
      <div class="coverflow-rail">
        <div class="coverflow-track coverflow-jesuites" data-flow-track tabindex="0" role="region" aria-roledescription="carrusel" aria-label="Projectes de Jesuïtes Educació">
          {jesuitesProjects.map((p, i) => (
            <article class="flow-item jesuites-entry" data-flow-item data-active={i===0 ? 'true' : 'false'}>
              <div class="jesuites-cover">
                <img src={p.cover} alt={'Portada de presentació del projecte '+p.title} width="440" height="618" loading="lazy" decoding="async" />
              </div>
              <div class="jesuites-copy">
                <span>PROJECTE · {p.course.toUpperCase()}</span>
                <h4>{p.title}</h4>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
    <p class="materials-note">Portades de presentació dels projectes desenvolupats amb Jesuïtes Educació.</p>
  </section>
</div>

<style>
.practice-materials{width:100%;max-width:100%;min-width:0;margin-top:44px;display:grid;gap:80px;overflow:hidden}
.material-group{width:100%;max-width:100%;min-width:0;border-top:1px solid var(--line);padding-top:39px}
.material-group-head{display:flex;justify-content:space-between;align-items:end;gap:28px;margin-bottom:25px;min-width:0}
.material-group-head>div{max-width:620px;min-width:0}
.material-kicker{font:800 10px/1.5 'DM Sans',Arial,sans-serif;color:var(--red);letter-spacing:.14em}
.material-group-head h3{font:650 clamp(30px,3.7vw,50px)/1.15 'Manrope',sans-serif;letter-spacing:-.062em;margin:12px 0 0;overflow-wrap:break-word}
.material-group-head h3 em{font-style:normal;color:var(--cyan)}
.material-group-head>p{font-size:14px;line-height:1.7;max-width:345px;color:var(--muted);margin:0}
.coverflow{min-width:0;width:100%;max-width:100%}
.coverflow-top{display:flex;justify-content:space-between;align-items:center;gap:18px;min-width:0}
.coverflow-hint{font-size:12px;color:var(--muted)}
.coverflow-controls{display:flex;align-items:center;gap:12px;white-space:nowrap;flex-shrink:0}
.coverflow-controls button{width:34px;height:34px;border:1px solid var(--line-strong);background:var(--white);border-radius:50%;color:var(--cyan);font-size:19px;line-height:1;cursor:pointer;transition:background .2s}
.coverflow-controls button:hover:not(:disabled){background:var(--cyan-pale)}
.coverflow-controls button:disabled{opacity:.28;cursor:default}
.coverflow-controls button:focus-visible{outline:2px solid var(--red);outline-offset:2px}
.coverflow-controls output{min-width:52px;text-align:center;font:700 11px/1.3 'DM Sans',Arial,sans-serif;color:var(--cyan);font-variant-numeric:tabular-nums}
.coverflow-rail{width:100%;max-width:100%;min-width:0;overflow:hidden}
.coverflow-track{--flow-width:242px;position:relative;display:flex;align-items:stretch;gap:19px;max-width:100%;width:100%;min-width:0;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;scroll-padding-inline:calc((100% - var(--flow-width))/2);padding:27px max(0px,calc((100% - var(--flow-width))/2)) 37px;scrollbar-width:none;overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch}
.coverflow-track::-webkit-scrollbar{display:none}
.coverflow-track:focus-visible{outline:2px solid var(--cyan);outline-offset:-2px}
.flow-item{flex:0 0 var(--flow-width);width:var(--flow-width);min-width:0;scroll-snap-align:center;transform-origin:center center;transform:perspective(950px) rotateY(0deg) scale(.88);opacity:.55;filter:saturate(.65);transition:transform .38s cubic-bezier(.18,.8,.24,1),opacity .38s ease,filter .38s ease,border-color .25s}
.flow-item.is-active{transform:perspective(950px) rotateY(0deg) scale(1.035);opacity:1;filter:none;z-index:3}
.flow-item.is-before{transform:perspective(950px) rotateY(19deg) scale(.83);opacity:.76;filter:saturate(.76);z-index:2}
.flow-item.is-after{transform:perspective(950px) rotateY(-19deg) scale(.83);opacity:.76;filter:saturate(.76);z-index:2}
.flow-item.is-far{transform:perspective(950px) rotateY(0deg) scale(.73);opacity:.42;filter:saturate(.55)}
.book-entry,.jesuites-entry{border:1px solid var(--line);background:var(--white);overflow:hidden;display:flex;flex-direction:column}
.flow-item.is-active{border-color:var(--line-strong);box-shadow:0 8px 24px rgba(16,48,63,.08)}
.book-visual{position:relative;display:flex;align-items:center;justify-content:center;min-height:284px;background:var(--cyan-pale);padding:18px;text-decoration:none;overflow:hidden}
.book-visual img{position:absolute;inset:16px;width:calc(100% - 32px);height:calc(100% - 32px);object-fit:contain;filter:drop-shadow(0 4px 8px rgba(16,44,61,.17))}
.book-fallback{display:flex;flex-direction:column;justify-content:space-between;gap:12px;min-height:217px;width:170px;background:#fff;color:var(--cyan);box-shadow:5px 8px 16px rgba(0,0,0,.09);border-top:13px solid #138a70;padding:12px}
.book-fallback small{font:800 8px 'Manrope',sans-serif;letter-spacing:.09em}
.book-fallback strong{font:750 18px/1.22 'Manrope',sans-serif;letter-spacing:-.04em}
.book-fallback>span{font:700 10px 'Manrope',sans-serif}
.book-meta{padding:17px 17px 19px;display:flex;flex-direction:column;gap:8px;flex:1;min-width:0}
.book-meta>span,.jesuites-copy>span{font:800 10px/1.35 'DM Sans',sans-serif;color:var(--red);letter-spacing:.07em}
.book-meta h4,.jesuites-copy h4{font:650 16px/1.36 'Manrope',sans-serif;letter-spacing:-.035em;color:var(--ink);margin:0;overflow-wrap:anywhere}
.book-meta>small{font-size:11px;color:var(--muted)}
.book-links{display:flex;flex-wrap:wrap;align-items:center;gap:9px 13px;margin-top:auto;padding-top:8px}
.book-links a{font:750 11px 'Manrope',sans-serif;color:var(--cyan);text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:3px}
.book-links a:hover{color:var(--red)}
.book-links a:focus-visible,.book-visual:focus-visible{outline:2px solid var(--red);outline-offset:2px}
.materials-note{margin:10px 0 0;color:var(--muted);font-size:11px;line-height:1.6}
.coverflow-jesuites{--flow-width:272px}
.jesuites-cover{width:100%;aspect-ratio:440/618;background:var(--cyan-pale);overflow:hidden}
.jesuites-cover img{display:block;width:100%;height:100%;object-fit:cover;object-position:center}
.jesuites-copy{display:flex;flex-direction:column;gap:8px;flex:1;padding:17px 17px 20px}
@media(max-width:760px){
  .practice-materials{margin-top:34px;gap:62px}
  .material-group{padding-top:30px}
  .material-group-head{flex-direction:column;align-items:flex-start;gap:11px;margin-bottom:20px}
  .material-group-head>p{max-width:100%}
  .coverflow-track{--flow-width:clamp(183px,58vw,234px);gap:6px;padding-top:24px;padding-bottom:30px}
  .coverflow-jesuites{--flow-width:clamp(195px,62vw,250px)}
  .book-visual{min-height:238px}
  .book-fallback{width:145px;min-height:177px}
  .book-fallback strong{font-size:15px}
  .book-meta h4,.jesuites-copy h4{font-size:14px}
  .flow-item.is-before{transform:perspective(750px) rotateY(22deg) scale(.83)}
  .flow-item.is-after{transform:perspective(750px) rotateY(-22deg) scale(.83)}
  .coverflow-hint{font-size:11px}
}
@media(max-width:400px){
  .coverflow-top{align-items:flex-start;gap:5px}
  .coverflow-hint{max-width:145px;line-height:1.4}
  .coverflow-controls{gap:7px}
  .coverflow-controls button{width:32px;height:32px}
}
@media(prefers-reduced-motion:reduce){
  .flow-item,.flow-item.is-active,.flow-item.is-before,.flow-item.is-after,.flow-item.is-far{transform:none;opacity:1;filter:none;transition:none}
  .coverflow-track{scroll-behavior:auto}
  .coverflow-controls button{transition:none}
}
</style>

<script>
(() => {
  function initCoverflow(flow) {
    const track = flow.querySelector('[data-flow-track]');
    const cards = Array.from(flow.querySelectorAll('[data-flow-item]'));
    const prev = flow.querySelector('[data-flow-prev]');
    const next = flow.querySelector('[data-flow-next]');
    const counter = flow.querySelector('[data-flow-count]');
    if (!track || !cards.length || !prev || !next || !counter) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let active = -1;
    let frame = 0;

    function update() {
      frame = 0;
      const middle = track.scrollLeft + track.clientWidth / 2;
      let chosen = 0;
      let closest = Infinity;
      cards.forEach((card, i) => {
        const distance = Math.abs(card.offsetLeft + card.offsetWidth / 2 - middle);
        if (distance < closest) { closest = distance; chosen = i; }
      });
      if (chosen !== active) {
        active = chosen;
        cards.forEach((card, i) => {
          card.classList.toggle('is-active', i === active);
          card.classList.toggle('is-before', i === active - 1);
          card.classList.toggle('is-after', i === active + 1);
          card.classList.toggle('is-far', Math.abs(i-active) > 1);
          card.dataset.active = i === active ? 'true' : 'false';
        });
        counter.textContent = (active + 1) + ' / ' + cards.length;
        prev.disabled = active <= 0;
        next.disabled = active >= cards.length - 1;
      }
    }

    function schedule() {
      if (frame) return;
      frame = window.requestAnimationFrame(update);
    }

    function select(index) {
      const target = cards[Math.max(0, Math.min(cards.length - 1, index))];
      if (!target) return;
      track.scrollTo({
        left: Math.max(0, target.offsetLeft + target.offsetWidth / 2 - track.clientWidth / 2),
        behavior: reduced.matches ? 'instant' : 'smooth'
      });
    }

    prev.addEventListener('click', () => select(active - 1));
    next.addEventListener('click', () => select(active + 1));
    track.addEventListener('scroll', schedule, { passive: true });
    track.addEventListener('keydown', event => {
      if (event.key === 'ArrowLeft') { event.preventDefault(); select(active - 1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); select(active + 1); }
    });
    window.addEventListener('resize', schedule, { passive: true });
    window.addEventListener('load', schedule, { once: true });
    schedule();
  }

  function init() {
    document.querySelectorAll('[data-coverflow]').forEach(initCoverflow);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
  else init();
})();
</script>
